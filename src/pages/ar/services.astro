---
// src/pages/ar/services.astro
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import MobileCTABar from '../../components/MobileCTABar.astro';
import PageHero from '../../components/sections/PageHero.astro';
import { SITE, sitePath } from '../../data/site';

const title = 'جلي بلاط حفر الباطن 0539811299 | خدمات جلي وتلميع الرخام والسيراميك';
const description = 'جلي بلاط حفر الباطن 0539811299 | خدمات جلي الرخام، تلميع السيراميك، طحن التيرازو، وتغليف الجرانيت بأحدث ماكينات كلياندكس الإيطالية في جميع الأحياء. اتصل 0539811299.';

const services = [
  {
    icon: 'diamond',
    icon2: 'verified',
    image: '/images/client/marble-majlis.jpg',
    name: 'جلي وترميم الرخام',
    tagline: 'استعادة اللمعة الطبيعية لرخامك',
    desc: 'تقنية الجلي بالأقراص الماسية تزيل الخدوش والبقع والبهتان من أسطح الرخام — مع استعادة اللمعة المرآتية العميقة لأرضيات وجدران الرخام الإيطالي والمحلي.',
    steps: ['فحص السطح ورصد الخدوش', 'جلي بأقراص ماسية (خشن → ناعم)', 'بلورة وتغليف بالراتنج', 'تلميع نهائي بلمعة مرآتية'],
    benefits: ['لمعة كالمرآة', 'إزالة الخدوش والبقع', 'مادة حماية مقاومة للأشعة', 'حماية 3-5 سنوات'],
    duration: '4–8 ساعات لكل 100 م²',
  },
  {
    icon: 'crop_square',
    icon2: 'cleaning_services',
    image: '/images/client/stairs-marble.jpg',
    name: 'جلي السيراميك والبورسلان والدرج',
    tagline: 'تنظيف عميق وتلميع لجميع أنواع البلاط والسلالم',
    desc: 'تنظيف وتلميع متخصص للسيراميك والبورسلان والبلاط والدرج الداخلي. نزيل الأوساخ والترسبات الكلسية وطبقات الشمع القديمة، مع تلميع سطح لامع ومعقم.',
    steps: ['تقييم البلاط', 'تنظيف عميق بالمواد القلوية', 'ترميم الفاصل', 'تلميع السطح وتغليفه'],
    benefits: ['استعادة اللون الأصلي', 'تبييض الفاصل', 'معالجة مضادة للانزلاق متاحة', 'سطح سهل التنظيف'],
    duration: '3–6 ساعات لكل 100 م²',
  },
  {
    icon: 'texture',
    icon2: 'auto_awesome',
    image: '/images/client/commercial-hall.jpg',
    name: 'طحن وتلميع الصالات والمعارض التجارية',
    tagline: 'فن استعادة جمال الصالات الكبيرة والتيرازو',
    desc: 'أرضيات الصالات والمعارض تتألق بالصيانة الصحيحة. عملية الطحن الرطب بماكينات كلياندكس الإيطالية تسوي الأسطح وتمنح لمعة بلورية لا تُضاهى.',
    steps: ['تقييم المستوى وحقن الشقوق', 'طحن ماسي كوكبي', 'صقل السطح', 'بلورة عالية اللمعة'],
    benefits: ['سطح مستوٍ تماماً', 'تحمل حركة كثيفة', 'سطح صحي ومعقم', 'عملية صديقة للبيئة'],
    duration: '5–10 ساعات لكل 100 م²',
  },
  {
    icon: 'panorama_horizontal',
    icon2: 'shield',
    image: '/images/client/onyx-bathroom.jpg',
    name: 'تلميع وتغليف الجرانيت والرخام الديكوري',
    tagline: 'حماية استثمارك في الجرانيت والأونيكس الفاخر',
    desc: 'الجرانيت والأونيكس متين لكنه مسامي. عملية التلميع والتغليف تُعيد البريق العميق للجرانيت مع مواد نفاذة تحميه من الزيوت والماء والبقع.',
    steps: ['معالجة البقع المسبقة', 'تلميع ماسي', 'تنظيف بمادة متعادلة pH', 'تطبيق مادة تغليف نفاذة'],
    benefits: ['استعادة عمق اللون', 'مادة مضادة للبقع', 'مقاوم للزيت والماء', 'يمد عمر الجرانيت'],
    duration: '3–5 ساعات لكل 100 م²',
  },
  {
    icon: 'square_foot',
    icon2: 'eco',
    image: '/images/client/commercial-washroom.jpg',
    name: 'ترميم وتلميع مغاسل الرخام والحجر',
    tagline: 'معالجة متخصصة للمغاسل والأحواض الرخامية',
    desc: 'المغاسل الرخامية تتطلب معاملة متقنة لإزالة التكلسات واصفرار المياه وإعادة الصقل البلوري للحواف والأحواض لحماية تدوم طويلاً.',
    steps: ['إزالة التكلسات الكيميائية', 'صقل يدوي دقيق للحواف', 'ملء الفواصل بالإيبوكسي', 'تغليف نانو واقٍ'],
    benefits: ['إزالة اصفرار الماء', 'صقل حواف آمن', 'تشطيب بلوري لامع', 'مقاوم للرطوبة والبكتيريا'],
    duration: '4–6 ساعات للمغسلة',
  },
  {
    icon: 'foundation',
    icon2: 'construction',
    image: '/images/client/villa-hall.jpg',
    name: 'جلي صالات الفلل والبهو الملكي',
    tagline: 'فخامة ملكية ولمعان عاكس كالمرايا',
    desc: 'حوّل صالات الاستقبال والبهو الرئيسي إلى تحفة معمارية براقة تعكس الإضاءة والجمال مع معالجة كاملة لجميع الفواصل والعيوب السطحية.',
    steps: ['طحن السطح وتشكيله', 'حقن الشقوق', 'تطبيق طبقة التأسيس', 'تشطيب إيبوكسي زخرفي'],
    benefits: ['مقاوم للمواد الكيماوية', 'سطح بلا درزات', 'عمر افتراضي +10 سنوات', 'ألوان مخصصة'],
    duration: 'يوم إلى يومين لكل 100 م²',
  },
];
---

<BaseLayout {title} {description} lang="ar" canonical={SITE.url + '/ar/services/'}>
  <Header lang="ar" currentPage="services" />

  <PageHero
    lang="ar"
    title="خدمات الجلي والتلميع الاحترافية"
    subtitle="جلي الرخام، ترميم البلاط، طحن التيرازو، وتلميع الجرانيت في جميع أحياء حفر الباطن. حرفيون معتمدون، معدات إيطالية متطورة، نتائج مضمونة."
    badge="٦ خدمات متخصصة معتمدة"
    accentIcon="construction"
    breadcrumb={[
      { label: 'الرئيسية', href: sitePath('/') },
      { label: 'خدماتنا' },
    ]}
  />

  <main>
    <!-- ── Services Grid ── -->
    <section class="py-20 bg-[#fcf9f2]">
      <div class="max-w-7xl mx-auto px-6 lg:px-12">
        <div class="text-center mb-14">
          <p class="text-xs font-bold uppercase tracking-[0.2em] text-[#735b24] mb-3">ما نقدمه في jaliblaathafar.com</p>
          <h2 class="text-3xl lg:text-4xl font-bold text-[#001026] mb-4">كل سطح، بيد خبراء وتقنيات إيطالية</h2>
          <p class="text-[#44474e] max-w-2xl mx-auto leading-relaxed">
            من الرخام الطبيعي الفاخر إلى البورسلان والتيرازو والإيبوكسي، نستعيد كل سطح إلى رونقه المرآتي الأصلي مع عزل وحماية تدوم لسنوات.
          </p>
        </div>

        <div class="grid gap-8 md:grid-cols-2 lg:grid-cols-3">
          {services.map((svc) => (
            <article class="group bg-white rounded-2xl border border-[#e5e2db] overflow-hidden shadow-sm hover:shadow-xl hover:-translate-y-1.5 transition-all duration-300 flex flex-col justify-between">
              
              <!-- Card Header with Real Photo -->
              <div class="relative h-52 overflow-hidden bg-[#001026]">
                <img
                  src={svc.image}
                  alt={svc.name}
                  loading="lazy"
                  class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500 ease-out"
                />
                <div class="absolute inset-0 bg-gradient-to-t from-[#001026] via-[#001026]/40 to-transparent"></div>
                
                <!-- Floating Icons -->
                <div class="absolute top-4 inset-x-4 flex items-center justify-between pointer-events-none">
                  <span class="w-10 h-10 rounded-xl bg-[#001026]/80 backdrop-blur-md text-[#ffdf9f] flex items-center justify-center border border-white/10 shadow-md">
                    <span class="material-symbols-outlined text-2xl">{svc.icon}</span>
                  </span>
                  <span class="w-8 h-8 rounded-lg bg-white/20 backdrop-blur-md text-[#ffdf9f] flex items-center justify-center border border-white/20 shadow-sm">
                    <span class="material-symbols-outlined text-base">{svc.icon2}</span>
                  </span>
                </div>

                <!-- Title Overlay -->
                <div class="absolute bottom-4 inset-x-4 pointer-events-none">
                  <h3 class="text-white font-bold text-xl leading-tight mb-1 drop-shadow-md">{svc.name}</h3>
                  <p class="text-[#ffdf9f] text-xs font-semibold drop-shadow">{svc.tagline}</p>
                </div>
              </div>

              <!-- Card Body -->
              <div class="p-6 flex flex-col gap-5 flex-1 justify-between">
                <div>
                  <p class="text-[#44474e] text-sm leading-relaxed mb-4">{svc.desc}</p>
                  
                  <!-- Process Steps -->
                  <div class="mb-5">
                    <p class="text-[#001026] font-semibold text-xs uppercase tracking-wider mb-2.5">طريقة العمل المعتمدة:</p>
                    <ol class="space-y-1.5">
                      {svc.steps.map((step, si) => (
                        <li class="flex items-start gap-2.5 text-xs text-[#44474e]">
                          <span class="shrink-0 w-4 h-4 rounded-full bg-[#001026] text-[#fedb98] text-[9px] font-bold flex items-center justify-center mt-0.5">{si + 1}</span>
                          <span>{step}</span>
                        </li>
                      ))}
                    </ol>
                  </div>

                  <!-- Key Benefits -->
                  <div class="bg-[#f6f3ec] rounded-xl p-3.5 border border-[#e5e2db]">
                    <p class="text-[#001026] font-semibold text-xs uppercase tracking-wider mb-2">المزايا والضمان:</p>
                    <ul class="grid grid-cols-2 gap-1.5">
                      {svc.benefits.map(b => (
                        <li class="flex items-center gap-1.5 text-xs text-[#44474e]">
                          <span class="material-symbols-outlined text-[#3de273] text-[14px]">check_circle</span>
                          <span>{b}</span>
                        </li>
                      ))}
                    </ul>
                  </div>
                </div>

                <!-- Footer & CTA -->
                <div class="flex items-center justify-between pt-4 border-t border-[#e5e2db]">
                  <span class="text-xs text-[#74777f] flex items-center gap-1">
                    <span class="material-symbols-outlined text-[15px] text-[#735b24]">schedule</span>
                    <span>{svc.duration}</span>
                  </span>
                  <a
                    href={`https://wa.me/${SITE.waNumber}?text=${encodeURIComponent('السلام عليكم، أود طلب عرض سعر لمعاينة خدمة ' + svc.name + ' بحفر الباطن عبر jaliblaathafar.com')}`}
                    target="_blank"
                    rel="noopener"
                    class="text-xs font-bold text-[#002c0f] bg-[#66ff8e]/20 hover:bg-[#002c0f] hover:text-[#66ff8e] border border-[#002c0f]/20 px-3.5 py-1.5 rounded-lg transition-all flex items-center gap-1"
                  >
                    <span>اطلب عرض سعر</span>
                    <span class="material-symbols-outlined text-[13px]">arrow_back</span>
                  </a>
                </div>

              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- ── CTA ── -->
    <section class="py-20 bg-gradient-to-r from-[#001026] to-[#0b2545] text-white">
      <div class="max-w-4xl mx-auto px-6 lg:px-12 text-center">
        <span class="material-symbols-outlined text-[#ffdf9f] text-5xl mb-4 block">diamond</span>
        <h2 class="text-3xl lg:text-4xl font-bold text-white mb-4">هل أنت مستعد لاستعادة بريق ولمعان أرضياتك؟</h2>
        <p class="text-white/80 text-lg mb-8 max-w-2xl mx-auto">
          معاينة مجانية 100% في موقعك بجميع أحياء حفر الباطن مع عينة تجريبية حية على متر مربع.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a href={`https://wa.me/${SITE.waNumber}?text=${encodeURIComponent('السلام عليكم، أرغب في طلب معاينة مجانية لخدمات الجلي في حفر الباطن عبر jaliblaathafar.com')}`} target="_blank" rel="noopener"
             class="inline-flex items-center justify-center gap-2 bg-[#25D366] text-white hover:bg-[#20bd5a] transition-all px-8 py-4 rounded-xl font-bold text-base shadow-lg">
            <span class="material-symbols-outlined">chat</span>
            واتساب للحصول على عرض سعر فوري
          </a>
          <a href={`tel:${SITE.phone}`}
             class="inline-flex items-center justify-center gap-2 bg-white/10 hover:bg-white/20 text-white border border-white/30 transition-all px-8 py-4 rounded-xl font-bold text-base">
            <span class="material-symbols-outlined">call</span>
            اتصل بنا: 0539811299
          </a>
        </div>
      </div>
    </section>
  </main>

  <Footer lang="ar" />
  <MobileCTABar lang="ar" />
</BaseLayout>
