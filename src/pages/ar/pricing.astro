---
// src/pages/ar/pricing.astro — صفحة فريق العمل، القيادة، وطريقة التنفيذ والمعاينة
import PageLayout        from '../../layouts/PageLayout.astro';
import PageHero          from '../../components/sections/PageHero.astro';
import TeamShowcase      from '../../components/sections/TeamShowcase.astro';
import WorkflowDeepDive  from '../../components/sections/WorkflowDeepDive.astro';
import Districts         from '../../components/sections/Districts.astro';
import FAQ               from '../../components/sections/FAQ.astro';
import ContactForm       from '../../components/sections/ContactForm.astro';
import PricingStickyBar  from '../../components/sections/PricingStickyBar.astro';
import { SITE }          from '../../data/site';

const schema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "HomeAndConstructionBusiness",
  "name": "جلي بلاط حفرالباطن | فريق العمل والقيادة الميدانية",
  "founder": {
    "@type": "Person",
    "name": "Amir Chamkani (عامر تشامكاني)",
    "jobTitle": "Chief Executive Officer & Operations Director",
    "telephone": SITE.phone
  },
  "telephone": SITE.phone,
  "address": {
    "@type": "PostalAddress",
    "streetAddress": SITE.address.street,
    "addressLocality": SITE.address.city,
    "addressRegion": SITE.address.region,
    "addressCountry": SITE.address.country
  },
  "areaServed": SITE.districts.ar,
  "description": "فريق عمل جلي وتلميع الرخام والبلاط بحفر الباطن بقيادة الأستاذ عامر تشامكاني. معاينة ميدانية مجانية، فحص نوع الحجر، وماكينات كلياندكس الإيطالية."
});
---

<PageLayout
  title="فريق العمل وطريقة التنفيذ بحفر الباطن | إشراف عامر تشامكاني | جلي بلاط الباطن"
  description="تعرّف على طاقم عمل ومعلمي جلي وتلميع الرخام والبلاط بحفر الباطن بقيادة الأستاذ عامر تشامكاني. خطوات العمل، فحص نوع الحجر، معاينة مجانية وضمان معتمد."
  lang="ar"
  schemaJson={schema}
>
  <PageHero
    lang="ar"
    badge="القيادة الميدانية وفريق العمل المعتمد"
    title="فريق العمل والقيادة الميدانية وطريقة التنفيذ"
    subtitle="نؤمن بأن جودة صقل وتلميع الرخام تعتمد على براعة الفني وأحدث ماكينات كلياندكس الإيطالية. ولأن كل أرضية تتطلب فحصاً خاصاً لنوع الحجر، يقدم الأستاذ عامر تشامكاني وطاقمنا الفني معاينة ميدانية مجانية 100% مع عينة تجريبية حية."
  />

  <TeamShowcase     lang="ar" />
  <WorkflowDeepDive lang="ar" />
  <Districts        lang="ar" />
  <FAQ              lang="ar" />
  <ContactForm      lang="ar" />
  <PricingStickyBar lang="ar" />
</PageLayout>
