---
// src/pages/index.astro  — Arabic Homepage (default language)
import PageLayout from '../layouts/PageLayout.astro';
import Hero        from '../components/sections/Hero.astro';
import Stats       from '../components/sections/Stats.astro';
import Services    from '../components/sections/Services.astro';
import WhyUs       from '../components/sections/WhyUs.astro';
import BeforeAfter from '../components/sections/BeforeAfter.astro';
import HowItWorks  from '../components/sections/HowItWorks.astro';
import Districts   from '../components/sections/Districts.astro';
import Testimonials from '../components/sections/Testimonials.astro';
import FAQ         from '../components/sections/FAQ.astro';
import ContactForm from '../components/sections/ContactForm.astro';
import { SITE }    from '../data/site';

const schema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "HomeAndConstructionBusiness",
  "name": "جلي بلاط حفر الباطن 0539811299 | JaliBlaat Al Batin",
  "alternateName": [
    "مؤسسة جلي وتلميع الرخام والبلاط بحفر الباطن",
    "شركة جلي بلاط بحفر الباطن",
    "معلم جلي رخام حفر الباطن 0539811299",
    "رقم جلي بلاط حفر الباطن 0539811299"
  ],
  "url": SITE.url,
  "telephone": SITE.phone,
  "image": `${SITE.url}/images/og-default.jpg`,
  "priceRange": "$$",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": SITE.address.street,
    "addressLocality": SITE.address.city,
    "addressRegion": SITE.address.region,
    "postalCode": SITE.address.zip,
    "addressCountry": SITE.address.country
  },
  "geo": { "@type": "GeoCoordinates", "latitude": SITE.address.lat, "longitude": SITE.address.lng },
  "areaServed": SITE.districts.ar,
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": "4.9",
    "reviewCount": "164",
    "bestRating": "5",
    "worstRating": "1"
  },
  "openingHoursSpecification": [{
    "@type": "OpeningHoursSpecification",
    "dayOfWeek": ["Saturday","Sunday","Monday","Tuesday","Wednesday","Thursday","Friday"],
    "opens": "07:00", "closes": "23:00"
  }],
  "hasOfferCatalog": {
    "@type": "OfferCatalog",
    "name": "خدمات جلي وتلميع الأرضيات بحفر الباطن",
    "itemListElement": [
      { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "جلي وتلميع الرخام الطبيعي بالكريستال والألماس" } },
      { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "جلي وتنظيف البلاط والسيراميك والبورسلان" } },
      { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "طحن وترميم أرضيات التيرازو والبلاط البلدي" } },
      { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "تلميع وعزل الجرانيت الطبيعي ضد البقع" } },
      { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "ترميم وصقل الحجر الجيري والترافرتين" } },
      { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "طلاء وإصلاح أرضيات الإيبوكسي المقاومة" } }
    ]
  }
});
---

<PageLayout
  title="0539811299 جلي بلاط حفر الباطن | شركة جلي وتلميع رخام وبلاط بحفر الباطن"
  description="جلي بلاط حفر الباطن 0539811299 تنظيف وتلميع وتجديد للرخام والبلاط وإزالة الخدوش والبقع بأقراص الألماس الإيطالية. رقم معلم جلي بلاط بحفر الباطن 0539811299 معاينة مجانية وضمان معتمد."
  lang="ar"
  schemaJson={schema}
>
  <Hero        lang="ar" />
  <Stats       lang="ar" />
  <Services    lang="ar" />
  <WhyUs       lang="ar" />
  <BeforeAfter lang="ar" />
  <HowItWorks  lang="ar" />
  <Districts   lang="ar" />
  <Testimonials lang="ar" />
  <FAQ         lang="ar" />
  <ContactForm lang="ar" />
</PageLayout>
