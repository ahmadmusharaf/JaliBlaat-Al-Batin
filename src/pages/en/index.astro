---
// src/pages/en/index.astro  — English Homepage
import PageLayout from '../../layouts/PageLayout.astro';
import Hero        from '../../components/sections/Hero.astro';
import Stats       from '../../components/sections/Stats.astro';
import Services    from '../../components/sections/Services.astro';
import WhyUs       from '../../components/sections/WhyUs.astro';
import BeforeAfter from '../../components/sections/BeforeAfter.astro';
import HowItWorks  from '../../components/sections/HowItWorks.astro';
import Districts   from '../../components/sections/Districts.astro';
import Testimonials from '../../components/sections/Testimonials.astro';
import FAQ         from '../../components/sections/FAQ.astro';
import ContactForm from '../../components/sections/ContactForm.astro';
import { SITE }    from '../../data/site';

const schema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "HomeAndConstructionBusiness",
  "name": "JaliBlaat Al Batin — Luxury Stoneworks",
  "alternateName": "Tile & Marble Polishing Services in Hafar Al-Batin",
  "url": `${SITE.url}/en/`,
  "telephone": SITE.phone,
  "image": `${SITE.url}/images/og-default.jpg`,
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "King Faisal Road",
    "addressLocality": "Hafar Al-Batin",
    "addressRegion": "Eastern Province",
    "postalCode": SITE.address.zip,
    "addressCountry": SITE.address.country
  },
  "geo": { "@type": "GeoCoordinates", "latitude": SITE.address.lat, "longitude": SITE.address.lng },
  "areaServed": SITE.districts.en,
  "priceRange": "$$",
  "openingHoursSpecification": [{
    "@type": "OpeningHoursSpecification",
    "dayOfWeek": ["Saturday","Sunday","Monday","Tuesday","Wednesday","Thursday","Friday"],
    "opens": "07:00", "closes": "23:00"
  }]
});
---

<PageLayout
  title="Tile Polishing in Hafar Al-Batin | JaliBlaat Al Batin — Luxury Stoneworks"
  description="Professional tile, marble & floor polishing in Hafar Al-Batin. Italian diamond machines, crystal finish, free inspection, written warranty. Call or WhatsApp now!"
  lang="en"
  schemaJson={schema}
>
  <Hero        lang="en" />
  <Stats       lang="en" />
  <Services    lang="en" />
  <WhyUs       lang="en" />
  <BeforeAfter lang="en" />
  <HowItWorks  lang="en" />
  <Districts   lang="en" />
  <Testimonials lang="en" />
  <FAQ         lang="en" />
  <ContactForm lang="en" />
</PageLayout>
