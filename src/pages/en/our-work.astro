---
// src/pages/en/our-work.astro — Real Projects & Client Work in Hafar Al-Batin
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import MobileCTABar from '../../components/MobileCTABar.astro';
import PageHero from '../../components/sections/PageHero.astro';
import { SITE, sitePath, waLink } from '../../data/site';

const lang = 'en';
const title = '0539811299 Tile & Marble Polishing Portfolio | Hafar Al-Batin Projects';
const description = '0539811299 Tile and marble polishing in Hafar Al-Batin real photos. High-gloss diamond crystallization, scratch removal, and floor restoration across all districts.';

const categories = [
  { key: 'all', label: 'All Projects' },
  { key: 'marble', label: 'Marble & Crystallization' },
  { key: 'tile', label: 'Porcelain & Ceramic' },
  { key: 'exterior', label: 'Courtyards & Exterior' },
  { key: 'commercial', label: 'Commercial & Showrooms' },
];

const projects = [
  {
    id: 1,
    cat: 'marble',
    catLabel: 'Natural Marble',
    t: 'Luxury Villa Reception Hall Marble Polish — Al-Aziziyah',
    d: 'Rectified uneven tile lippage and raked out deteriorated grout, injected authentic color-matched Italian epoxy, followed by 7-stage diamond grit honing to liquid mirror gloss.',
    area: '280 m²',
    dist: 'Al-Aziziyah',
    dur: '3 Days',
    img: '/images/projects/project-villa-marble.jpg',
    tag: 'Italian Marble • Crystal Buff'
  },
  {
    id: 2,
    cat: 'marble',
    catLabel: 'VIP Majlis',
    t: 'Men’s VIP Majlis Marble Floor Crystallization — Al-Khalidiyah',
    d: 'Scratches eliminated and surface leveled with thermo-chemical crystallization and fluorochemical nano sealing against coffee, tea, and grease stains.',
    area: '220 m²',
    dist: 'Al-Khalidiyah',
    dur: '2 Days',
    img: '/images/projects/project-luxury-majlis.jpg',
    tag: 'Joint Bonding • Nano Shield'
  },
  {
    id: 3,
    cat: 'tile',
    catLabel: 'Porcelain & Tile',
    t: 'Residential Villa Porcelain & Tile Deep Polish — Al-Muhammadiyah',
    d: 'Specialized alkaline chemical deep scrub, grout whitening, removal of heavy wax and yellow oxidation layers, and non-slip surface treatment.',
    area: '340 m²',
    dist: 'Al-Muhammadiyah',
    dur: '3 Days',
    img: '/images/projects/project-best-tiles.jpg',
    tag: 'Grout Whitening • Anti-Slip'
  },
  {
    id: 4,
    cat: 'commercial',
    catLabel: 'Commercial',
    t: 'Commercial Showroom High-Traffic Floor Restoration — Al-Baladiyah',
    d: 'Lippage leveling and deep industrial degreasing using heavy Italian Klindex planetary machinery with high-durability diamond pads for dense foot traffic.',
    area: '520 m²',
    dist: 'Al-Baladiyah',
    dur: '4 Days',
    img: '/images/projects/project-commercial-showroom.jpg',
    tag: 'High Traffic • Klindex Planetary'
  },
  {
    id: 5,
    cat: 'exterior',
    catLabel: 'Exterior & Patio',
    t: 'Outdoor Courtyard & Entrance Tile Deep Scrubbing — Abu Musa',
    d: 'Removed stubborn dried cement, paint splatter, and harsh weather deposits from exterior tiles and stone stairs, finished with weather-resistant sealant.',
    area: '190 m²',
    dist: 'Abu Musa',
    dur: '2 Days',
    img: '/images/projects/project-outer-courtyard.jpg',
    tag: 'Cement Removal • Water Barrier'
  },
  {
    id: 6,
    cat: 'exterior',
    catLabel: 'Patio & Garden',
    t: 'Outdoor Patio & Garden Walkway Restoration — Al-Rawdah',
    d: 'Flexible expansion joint epoxy sealing and diamond scrubbing to convert rough weathered tile into an easy-to-clean, dust-repellent surface.',
    area: '250 m²',
    dist: 'Al-Rawdah',
    dur: '3 Days',
    img: '/images/projects/project-exterior-tiles.jpg',
    tag: 'Dust Repellent • Easy Clean'
  },
  {
    id: 7,
    cat: 'marble',
    catLabel: 'Natural Marble',
    t: 'High-Gloss Italian Crystal Mirror Finish — Al-Faisaliyah',
    d: 'Thermochemical crystal buffing generates stunning light reflection with an ultra-smooth hydrophobic barrier that repels liquid spills.',
    area: '180 m²',
    dist: 'Al-Faisaliyah',
    dur: '2 Days',
    img: '/images/projects/project-mirror-shine.jpg',
    tag: 'Mirror Gloss • Italian Crystals'
  },
  {
    id: 8,
    cat: 'tile',
    catLabel: 'Porcelain & Tile',
    t: 'Kitchen & Living Area Tile & Grout Restoration — Al-Tilal',
    d: 'Raked out cracked grout lines, injected high-density moisture-resistant epoxy, and buffed tiles for a harmonious, hygienic shine.',
    area: '160 m²',
    dist: 'Al-Tilal',
    dur: '2 Days',
    img: '/images/projects/project-deep-grout-cleaning.jpg',
    tag: 'Epoxy Injection • Deep Scrub'
  },
  {
    id: 9,
    cat: 'exterior',
    catLabel: 'Exterior & Patio',
    t: 'Rooftop Terrace Tile & Stone Grinding — Al-Nuzha',
    d: 'Removed mineral calcification caused by rain, sealed expansion joints with UV-stable and heat-resistant sealants tailored for Hafar Al-Batin climate.',
    area: '210 m²',
    dist: 'Al-Nuzha',
    dur: '2 Days',
    img: '/images/projects/project-terrace-restoration.jpg',
    tag: 'UV Protected • Joint Seal'
  },
  {
    id: 10,
    cat: 'marble',
    catLabel: 'Stairs & Hallways',
    t: 'Hallway & Marble Staircase Precision Honing — Al-Wahat',
    d: 'Detailed edge and corner grinding using specialized hand machines, followed by crystal buffing and safety anti-slip strip installation.',
    area: '130 m²',
    dist: 'Al-Wahat',
    dur: '1.5 Days',
    img: '/images/projects/project-hallway-refinement.jpg',
    tag: 'Stair Polish • Safety Edges'
  },
  {
    id: 11,
    cat: 'marble',
    catLabel: 'Villa Estates',
    t: 'Full Estate Marble Nano Shield Sealing — Al-Rabwah',
    d: '100% pore closure of natural marble with durable fluorochemical barriers, finalized with an official written warranty certificate.',
    area: '420 m²',
    dist: 'Al-Rabwah',
    dur: '4 Days',
    img: '/images/projects/project-premium-crystallization.jpg',
    tag: 'Certified Warranty • Pore Seal'
  },
  {
    id: 12,
    cat: 'tile',
    catLabel: 'Diamond Leveling',
    t: 'Planetary Diamond Grinding & Height Equalization — Al-Rayyan',
    d: 'Erased lippage and sharp uneven edges between tiles with Klindex machines to create a continuous, perfectly level monolithic surface.',
    area: '310 m²',
    dist: 'Al-Rayyan',
    dur: '3 Days',
    img: '/images/projects/project-diamond-leveling.jpg',
    tag: 'Lippage Removal • Klindex'
  }
];
---

<BaseLayout {title} {description} lang="en" canonical={SITE.url + '/en/our-work/'}>
  <Header lang="en" currentPage="our-work" />

  <PageHero
    lang="en"
    title="Our Real Projects & Job Site Gallery"
    subtitle="All photography shown was captured live from our actual residential villa, commercial, and majlis projects across Hafar Al-Batin. Authentic craftsmanship by our certified technicians."
    badge="100% Verified Real Client Work"
    accentIcon="photo_camera"
    breadcrumb={[
      { label: 'Home', href: sitePath('/en/') },
      { label: 'Our Work' },
    ]}
  />

  <main>
    <!-- ── Live Proof Counter Bar ── -->
    <section class="bg-[#0b2545] py-10 border-y border-white/10">
      <div class="max-w-7xl mx-auto px-6 lg:px-12 grid grid-cols-2 lg:grid-cols-4 gap-6 text-center">
        {[
          { n: '+500', l: 'Projects Completed in Hafar Al-Batin', icon: 'check_circle' },
          { n: '100%', l: 'Real Photos From Our Job Sites', icon: 'photo_camera' },
          { n: '12', l: 'Districts Covered with Free Inspection', icon: 'location_on' },
          { n: '10', l: 'Years Certified Shine Warranty', icon: 'workspace_premium' },
        ].map(s => (
          <div>
            <span class="material-symbols-outlined text-[#ffdf9f] text-3xl mb-2 block">{s.icon}</span>
            <div class="text-3xl font-bold text-white font-['Inter'] mb-1">{s.n}</div>
            <div class="text-white/70 text-xs font-semibold">{s.l}</div>
          </div>
        ))}
      </div>
    </section>

    <!-- ── Featured Before & After Real Showcase ── -->
    <section class="py-16 bg-[#f0eee7] border-b border-[#e5e2db]">
      <div class="max-w-7xl mx-auto px-6 lg:px-12">
        <div class="text-center max-w-2xl mx-auto mb-10">
          <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-[#fedb98] text-[#785f28] text-xs font-bold font-['Inter'] mb-3">
            <span class="material-symbols-outlined text-[15px]">compare</span>
            Real Job Site Transformation
          </span>
          <h2 class="text-2xl md:text-4xl font-bold text-[#001026] mb-3">
            Witness the Concrete Difference: Before & After
          </h2>
          <p class="text-sm text-[#44474e]">
            Live capture from a tile cleaning, grout rehabilitation, and crystallization project in Hafar Al-Batin showing the elimination of dullness and restored brilliance.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 max-w-4xl mx-auto">
          <!-- Before Card -->
          <div class="relative rounded-2xl overflow-hidden border border-[#e5e2db] shadow-md bg-white">
            <div class="relative h-64 sm:h-72">
              <img src="/images/projects/project-before-state.jpg" alt="Floor condition before polishing" class="w-full h-full object-cover" />
              <div class="absolute inset-0 bg-black/20"></div>
              <span class="absolute top-4 left-4 bg-[#ba1a1a] text-white text-xs font-bold px-3 py-1 rounded-lg shadow-md flex items-center gap-1">
                <span class="material-symbols-outlined text-[14px]">cancel</span>
                Before Polishing (Dull & Stained)
              </span>
            </div>
            <div class="p-4 bg-white text-xs text-[#44474e] border-t border-[#e5e2db]">
              Aged floor showing heavy oxidation, calcium deposits, and deteriorated cement grout.
            </div>
          </div>

          <!-- After Card -->
          <div class="relative rounded-2xl overflow-hidden border-2 border-[#735b24] shadow-lg bg-white ring-2 ring-[#735b24]/20">
            <div class="relative h-64 sm:h-72">
              <img src="/images/projects/project-after-finish.jpg" alt="Floor condition after polishing" class="w-full h-full object-cover" />
              <div class="absolute inset-0 bg-gradient-to-t from-black/40 via-transparent to-transparent"></div>
              <span class="absolute top-4 left-4 bg-[#002c0f] text-[#66ff8e] text-xs font-bold px-3 py-1 rounded-lg shadow-md flex items-center gap-1 border border-[#66ff8e]/30">
                <span class="material-symbols-outlined text-[14px]">check_circle</span>
                After Polishing (Mirror Brilliance)
              </span>
            </div>
            <div class="p-4 bg-white text-xs font-semibold text-[#001026] border-t border-[#e5e2db] flex items-center justify-between">
              <span>Whitened grout lines, wet diamond grinding, and liquid-glass reflection.</span>
              <span class="text-[#735b24] font-bold">Certified Warranty</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ── Filter Tabs & Main Gallery ── -->
    <section class="py-20 bg-[#fcf9f2]" id="gallery-grid">
      <div class="max-w-7xl mx-auto px-6 lg:px-12">
        
        <!-- Section Header -->
        <div class="text-center mb-10">
          <h2 class="text-3xl lg:text-4xl font-bold text-[#001026] mb-3">
            District Project Archive
          </h2>
          <p class="text-sm md:text-base text-[#44474e] max-w-2xl mx-auto">
            Browse through authentic verified work across luxury villas, VIP majlis halls, and commercial facilities in Hafar Al-Batin.
          </p>
        </div>

        <!-- Category Filter Buttons -->
        <div class="flex flex-wrap items-center justify-center gap-2 mb-12">
          {categories.map((c, i) => (
            <button
              class={`filter-btn px-4 py-2 rounded-xl text-xs font-bold font-['Inter'] transition-all ${i === 0 ? 'bg-[#001026] text-white shadow-md' : 'bg-white text-[#44474e] border border-[#e5e2db] hover:border-[#735b24] hover:text-[#001026]'}`}
              data-cat={c.key}
            >
              {c.label}
            </button>
          ))}
        </div>

        <!-- Projects Cards Grid -->
        <div class="grid gap-8 md:grid-cols-2 lg:grid-cols-3" id="projects-container">
          {projects.map((p) => (
            <article
              class="project-card group bg-white rounded-2xl border border-[#e5e2db] overflow-hidden shadow-sm hover:shadow-xl hover:-translate-y-1.5 transition-all duration-300 flex flex-col justify-between"
              data-category={p.cat}
            >
              <!-- Card Photo Header -->
              <div class="relative h-60 overflow-hidden bg-[#001026]">
                <img
                  src={p.img}
                  alt={p.t}
                  loading="lazy"
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500 ease-out"
                />
                <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent"></div>
                
                <!-- Category Badge -->
                <div class="absolute top-3.5 left-3.5">
                  <span class="bg-[#001026]/85 backdrop-blur-md text-[#fedb98] text-[11px] font-bold px-3 py-1 rounded-lg border border-white/10 shadow-md">
                    {p.catLabel}
                  </span>
                </div>

                <!-- Verified Stamp -->
                <div class="absolute bottom-3.5 right-3.5 left-3.5 flex items-center justify-between text-white text-xs">
                  <span class="bg-[#002c0f]/80 backdrop-blur-md text-[#66ff8e] px-2.5 py-0.5 rounded text-[10px] font-semibold flex items-center gap-1 border border-[#66ff8e]/30">
                    <span class="material-symbols-outlined text-[13px]">verified</span>
                    Verified in Hafar Al-Batin
                  </span>
                  <span class="text-[#ffdf9f] text-[11px] font-medium drop-shadow">
                    {p.tag}
                  </span>
                </div>
              </div>

              <!-- Card Body -->
              <div class="p-6 flex flex-col justify-between flex-1">
                <div>
                  <h3 class="font-bold text-[#001026] text-base leading-snug mb-2 group-hover:text-[#735b24] transition-colors">
                    {p.t}
                  </h3>
                  <p class="text-[#44474e] text-xs md:text-sm leading-relaxed mb-4">
                    {p.d}
                  </p>
                </div>

                <div>
                  <!-- Project Specs Strip -->
                  <div class="flex items-center justify-between text-xs text-[#74777f] py-3 border-y border-[#f0eee7] mb-4">
                    <span class="flex items-center gap-1">
                      <span class="material-symbols-outlined text-[15px] text-[#735b24]">location_on</span>
                      <span>{p.dist}</span>
                    </span>
                    <span class="flex items-center gap-1 font-semibold text-[#001026]">
                      <span class="material-symbols-outlined text-[15px] text-[#735b24]">square_foot</span>
                      <span>{p.area}</span>
                    </span>
                    <span class="flex items-center gap-1">
                      <span class="material-symbols-outlined text-[15px] text-[#735b24]">schedule</span>
                      <span>{p.dur}</span>
                    </span>
                  </div>

                  <!-- WhatsApp Action Button -->
                  <a
                    href={`https://wa.me/${SITE.waNumber}?text=${encodeURIComponent('Hello, I saw your project (' + p.t + ') on jaliblaathafar.com and would like an estimate for similar results on my floor')}`}
                    target="_blank"
                    rel="noopener"
                    class="w-full flex items-center justify-center gap-2 bg-[#f6f3ec] hover:bg-[#001026] text-[#001026] hover:text-white py-2.5 px-4 rounded-xl text-xs font-bold transition-all border border-[#e5e2db] group-hover:border-[#001026]"
                  >
                    <span class="material-symbols-outlined text-[15px] text-[#25D366]">chat</span>
                    <span>Request Similar Result via WhatsApp</span>
                  </a>
                </div>
              </div>

            </article>
          ))}
        </div>

      </div>
    </section>

    <!-- ── Interactive Category Filtering Script ── -->
    <script>
      const buttons = document.querySelectorAll('.filter-btn');
      const cards = document.querySelectorAll('.project-card');

      buttons.forEach(btn => {
        btn.addEventListener('click', () => {
          buttons.forEach(b => {
            b.classList.remove('bg-[#001026]', 'text-white', 'shadow-md');
            b.classList.add('bg-white', 'text-[#44474e]', 'border', 'border-[#e5e2db]');
          });
          btn.classList.remove('bg-white', 'text-[#44474e]', 'border', 'border-[#e5e2db]');
          btn.classList.add('bg-[#001026]', 'text-white', 'shadow-md');

          const cat = btn.getAttribute('data-cat');
          cards.forEach(card => {
            const cardCat = card.getAttribute('data-category');
            if (cat === 'all' || cardCat === cat) {
              (card as HTMLElement).style.display = 'flex';
            } else {
              (card as HTMLElement).style.display = 'none';
            }
          });
        });
      });
    </script>

    <!-- ── Call To Action ── -->
    <section class="py-20 bg-gradient-to-r from-[#001026] to-[#0b2545] text-white">
      <div class="max-w-4xl mx-auto px-6 lg:px-12 text-center">
        <span class="material-symbols-outlined text-[#ffdf9f] text-5xl mb-4 block">diamond</span>
        <h2 class="text-3xl lg:text-4xl font-bold text-white mb-4">Ready to Transform Your Floors to Hotel-Grade Brilliance?</h2>
        <p class="text-white/80 text-base md:text-lg mb-8 max-w-2xl mx-auto">
          We visit you anywhere in Hafar Al-Batin to inspect your floor and provide a 100% free live 1 m² test patch before any commitment.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a
            href={`https://wa.me/${SITE.waNumber}?text=${encodeURIComponent('Hello, I would like to schedule a free on-site stone inspection in Hafar Al-Batin via jaliblaathafar.com')}`}
            target="_blank"
            rel="noopener"
            class="inline-flex items-center justify-center gap-2 bg-[#25D366] text-white hover:bg-[#20bd5a] transition-all px-8 py-4 rounded-xl font-bold text-base shadow-lg"
          >
            <span class="material-symbols-outlined text-2xl">chat</span>
            <span>WhatsApp Instant Inspection</span>
          </a>
          <a
            href={`tel:${SITE.phone}`}
            class="inline-flex items-center justify-center gap-2 bg-white/10 hover:bg-white/20 text-white border border-white/30 transition-all px-8 py-4 rounded-xl font-bold text-base"
          >
            <span class="material-symbols-outlined text-2xl">call</span>
            <span dir="ltr">{SITE.phoneDisplay}</span>
          </a>
        </div>
      </div>
    </section>

  </main>

  <Footer lang="en" />
  <MobileCTABar lang="en" />
</BaseLayout>
