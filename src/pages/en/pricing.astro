---
// src/pages/en/pricing.astro — Our Team, Leadership & Precision Workflow Page
import PageLayout        from '../../layouts/PageLayout.astro';
import PageHero          from '../../components/sections/PageHero.astro';
import TeamShowcase      from '../../components/sections/TeamShowcase.astro';
import WorkflowDeepDive  from '../../components/sections/WorkflowDeepDive.astro';
import Districts         from '../../components/sections/Districts.astro';
import FAQ               from '../../components/sections/FAQ.astro';
import ContactForm       from '../../components/sections/ContactForm.astro';
import PricingStickyBar  from '../../components/sections/PricingStickyBar.astro';
import { SITE }          from '../../data/site';

const schema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "HomeAndConstructionBusiness",
  "name": "JaliBlaat Al Batin | Leadership & Stoneworks Field Team",
  "founder": {
    "@type": "Person",
    "name": "Amir Chamkani",
    "jobTitle": "Chief Executive Officer & Stoneworks Director",
    "telephone": SITE.phone
  },
  "telephone": SITE.phone,
  "address": {
    "@type": "PostalAddress",
    "streetAddress": SITE.address.street,
    "addressLocality": SITE.address.city,
    "addressRegion": SITE.address.region,
    "addressCountry": SITE.address.country
  },
  "areaServed": SITE.districts.en,
  "description": "Meet the master stoneworkers and precision stone restoration team in Hafar Al-Batin led by CEO Amir Chamkani. Free on-site diagnostic, Klindex machinery, and certified shine warranty."
});
---

<PageLayout
  title="Our Team & Precision Workflow in Hafar Al-Batin | Led by Amir Chamkani"
  description="Meet our master marble and tile polishing craftsmen in Hafar Al-Batin directed by Amir Chamkani. Discover our 4-step Klindex protocol, free on-site stone inspection, and written warranty."
  lang="en"
  schemaJson={schema}
>
  <PageHero
    lang="en"
    badge="Certified Field Leadership & Stoneworks Team"
    title="Our Leadership, Master Stoneworkers & Precision Workflow"
    subtitle="We believe authentic marble brilliance depends on experienced stone masons and Italian Klindex machinery. Because every stone slab requires unique diagnosis, CEO Amir Chamkani and our field specialists conduct 100% free inspections and test patches."
  />

  <TeamShowcase     lang="en" />
  <WorkflowDeepDive lang="en" />
  <Districts        lang="en" />
  <FAQ              lang="en" />
  <ContactForm      lang="en" />
  <PricingStickyBar lang="en" />
</PageLayout>
