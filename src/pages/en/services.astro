---
// src/pages/en/services.astro
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import MobileCTABar from '../../components/MobileCTABar.astro';
import PageHero from '../../components/sections/PageHero.astro';
import { SITE, sitePath } from '../../data/site';

const lang = 'en';
const title = '0539811299 Tile & Marble Polishing Services in Hafar Al-Batin';
const description = '0539811299 Professional marble polishing, tile restoration, terrazzo grinding, and granite sealing in Hafar Al-Batin. Italian diamond technology & written warranty.';

const services = [
  {
    icon: 'diamond',
    icon2: 'verified',
    image: 'https://images.unsplash.com/photo-1600585154340-be6161a56a0c?auto=format&fit=crop&w=800&q=80',
    name: 'Marble Polishing & Restoration',
    tagline: 'Revive the natural brilliance of your marble',
    desc: 'Our diamond-grinding process removes scratches, stains, and dullness from marble surfaces — restoring the deep mirror shine of Italian and local marble floors, walls, and countertops.',
    steps: ['Surface inspection & scratch mapping', 'Diamond disc grinding (coarse → fine)', 'Crystallisation & resin sealing', 'Mirror-finish buffing'],
    benefits: ['Mirror-like shine', 'Scratch & stain removal', 'UV-stable sealant', '3–5 year protection'],
    duration: '4–8 hours per 100 m²',
  },
  {
    icon: 'crop_square',
    icon2: 'cleaning_services',
    image: 'https://images.unsplash.com/photo-1584622650111-993a426fbf0a?auto=format&fit=crop&w=800&q=80',
    name: 'Ceramic & Porcelain Tile Polishing',
    tagline: 'Deep clean and polish for all tile types',
    desc: 'Specialised cleaning and polishing for ceramic, porcelain, and glazed tiles. We remove grout haze, calcium build-up, and old wax layers, leaving tiles bright and hygienic.',
    steps: ['Tile assessment', 'Deep alkaline cleaning', 'Grout rehabilitation', 'Surface polishing & sealing'],
    benefits: ['Restored original colour', 'Grout whitening', 'Anti-slip treatment available', 'Easy-clean surface'],
    duration: '3–6 hours per 100 m²',
  },
  {
    icon: 'texture',
    icon2: 'auto_awesome',
    image: 'https://images.unsplash.com/photo-1615873968403-89e068629265?auto=format&fit=crop&w=800&q=80',
    name: 'Terrazzo Grinding & Polishing',
    tagline: 'The art of restoring terrazzo beauty',
    desc: 'Terrazzo floors age beautifully when properly maintained. Our wet-grinding process levels uneven surfaces, removes cracks, and delivers a flawless polished finish.',
    steps: ['Level assessment & crack filling', 'Wet diamond grinding', 'Surface honing', 'High-gloss crystallisation'],
    benefits: ['Perfectly flat surface', 'Crack repair included', 'Hygienic surface', 'Eco-friendly process'],
    duration: '5–10 hours per 100 m²',
  },
  {
    icon: 'panorama_horizontal',
    icon2: 'shield',
    image: 'https://images.unsplash.com/photo-1618221195710-dd6b41faaea6?auto=format&fit=crop&w=800&q=80',
    name: 'Granite Polishing & Sealing',
    tagline: 'Protect your premium granite investment',
    desc: 'Granite is durable but porous. Our polishing and sealing process brings back the deep lustre of granite surfaces while applying penetrating sealants that protect against oil, water, and stains.',
    steps: ['Stain removal pre-treatment', 'Diamond polishing', 'pH-balanced cleaning', 'Penetrating sealant application'],
    benefits: ['Deep colour restoration', 'Stain-proof sealant', 'Oil & water resistant', 'Extends granite life'],
    duration: '3–5 hours per 100 m²',
  },
  {
    icon: 'square_foot',
    icon2: 'eco',
    image: 'https://images.unsplash.com/photo-1590381105924-c72589b9ef3f?auto=format&fit=crop&w=800&q=80',
    name: 'Limestone & Travertine Restoration',
    tagline: 'Sensitive stone, expert treatment',
    desc: 'Limestone and travertine require gentle handling. We use specialised low-pH compounds and soft-grit discs to polish without damaging the delicate crystal structure of these natural stones.',
    steps: ['pH testing', 'Gentle honing process', 'Void filling (travertine)', 'Surface sealing'],
    benefits: ['Safe for soft stone', 'Void & hole filling', 'Natural-look finish', 'Breathable sealant'],
    duration: '5–8 hours per 100 m²',
  },
  {
    icon: 'foundation',
    icon2: 'construction',
    image: 'https://images.unsplash.com/photo-1581092160607-ee22621dd758?auto=format&fit=crop&w=800&q=80',
    name: 'Epoxy Floor Coating & Repair',
    tagline: 'Industrial durability, residential beauty',
    desc: 'Transform worn concrete or tile floors with professional epoxy coatings. Perfect for garages, service areas, and commercial spaces — durable, seamless, and easy to maintain.',
    steps: ['Surface grinding & profiling', 'Crack injection', 'Primer coat application', 'Decorative epoxy finish'],
    benefits: ['Chemical resistant', 'Seamless surface', '10+ year lifespan', 'Custom colours'],
    duration: '1–2 days per 100 m²',
  },
];
---

<BaseLayout {title} {description} lang="en" canonical={SITE.url + '/en/services/'}>
  <Header lang="en" currentPage="services" />

  <PageHero
    lang="en"
    title="Professional Polishing & Restoration Services"
    subtitle="Marble polishing, tile restoration, terrazzo grinding, and granite sealing across all Hafar Al-Batin districts. Certified stonemasons, Italian machinery, guaranteed results."
    badge="6 Specialized Services"
    accentIcon="construction"
    breadcrumb={[
      { label: 'Home', href: sitePath('/en/') },
      { label: 'Services' },
    ]}
  />

  <main>
    <!-- ── Services Grid ── -->
    <section class="py-20 bg-[#fcf9f2]">
      <div class="max-w-7xl mx-auto px-6 lg:px-12">
        <div class="text-center mb-14">
          <p class="text-xs font-bold uppercase tracking-[0.2em] text-[#735b24] mb-3">Our Expertise at jaliblaathafar.com</p>
          <h2 class="text-3xl lg:text-4xl font-bold text-[#001026] mb-4">Every Surface, Mastered by Experts</h2>
          <p class="text-[#44474e] max-w-2xl mx-auto leading-relaxed">
            From classic Crema Marfil marble to modern porcelain and durable epoxy, we restore every surface to mirror brilliance with certified Italian Klindex machinery.
          </p>
        </div>

        <div class="grid gap-8 md:grid-cols-2 lg:grid-cols-3">
          {services.map((svc) => (
            <article class="group bg-white rounded-2xl border border-[#e5e2db] overflow-hidden shadow-sm hover:shadow-xl hover:-translate-y-1.5 transition-all duration-300 flex flex-col justify-between">
              
              <!-- Card Header with Real Photo -->
              <div class="relative h-52 overflow-hidden bg-[#001026]">
                <img
                  src={svc.image}
                  alt={svc.name}
                  loading="lazy"
                  class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500 ease-out"
                />
                <div class="absolute inset-0 bg-gradient-to-t from-[#001026] via-[#001026]/40 to-transparent"></div>
                
                <!-- Floating Icons -->
                <div class="absolute top-4 inset-x-4 flex items-center justify-between pointer-events-none">
                  <span class="w-10 h-10 rounded-xl bg-[#001026]/80 backdrop-blur-md text-[#ffdf9f] flex items-center justify-center border border-white/10 shadow-md">
                    <span class="material-symbols-outlined text-2xl">{svc.icon}</span>
                  </span>
                  <span class="w-8 h-8 rounded-lg bg-white/20 backdrop-blur-md text-[#ffdf9f] flex items-center justify-center border border-white/20 shadow-sm">
                    <span class="material-symbols-outlined text-base">{svc.icon2}</span>
                  </span>
                </div>

                <!-- Title Overlay -->
                <div class="absolute bottom-4 inset-x-4 pointer-events-none">
                  <h3 class="text-white font-bold text-xl leading-tight mb-1 drop-shadow-md">{svc.name}</h3>
                  <p class="text-[#ffdf9f] text-xs font-semibold drop-shadow">{svc.tagline}</p>
                </div>
              </div>

              <!-- Card Body -->
              <div class="p-6 flex flex-col gap-5 flex-1 justify-between">
                <div>
                  <p class="text-[#44474e] text-sm leading-relaxed mb-4">{svc.desc}</p>
                  
                  <!-- Process Steps -->
                  <div class="mb-5">
                    <p class="text-[#001026] font-semibold text-xs uppercase tracking-wider mb-2.5">Our Proven Process:</p>
                    <ol class="space-y-1.5">
                      {svc.steps.map((step, si) => (
                        <li class="flex items-start gap-2.5 text-xs text-[#44474e]">
                          <span class="shrink-0 w-4 h-4 rounded-full bg-[#001026] text-[#fedb98] text-[9px] font-bold flex items-center justify-center mt-0.5">{si + 1}</span>
                          <span>{step}</span>
                        </li>
                      ))}
                    </ol>
                  </div>

                  <!-- Key Benefits -->
                  <div class="bg-[#f6f3ec] rounded-xl p-3.5 border border-[#e5e2db]">
                    <p class="text-[#001026] font-semibold text-xs uppercase tracking-wider mb-2">Key Benefits:</p>
                    <ul class="grid grid-cols-2 gap-1.5">
                      {svc.benefits.map(b => (
                        <li class="flex items-center gap-1.5 text-xs text-[#44474e]">
                          <span class="material-symbols-outlined text-[#3de273] text-[14px]">check_circle</span>
                          <span>{b}</span>
                        </li>
                      ))}
                    </ul>
                  </div>
                </div>

                <!-- Footer & CTA -->
                <div class="flex items-center justify-between pt-4 border-t border-[#e5e2db]">
                  <span class="text-xs text-[#74777f] flex items-center gap-1">
                    <span class="material-symbols-outlined text-[15px] text-[#735b24]">schedule</span>
                    <span>{svc.duration}</span>
                  </span>
                  <a
                    href={`https://wa.me/${SITE.waNumber}?text=${encodeURIComponent('Hello, I would like to request a quote for ' + svc.name + ' in Hafar Al-Batin via jaliblaathafar.com')}`}
                    target="_blank"
                    rel="noopener"
                    class="text-xs font-bold text-[#002c0f] bg-[#66ff8e]/20 hover:bg-[#002c0f] hover:text-[#66ff8e] border border-[#002c0f]/20 px-3.5 py-1.5 rounded-lg transition-all flex items-center gap-1"
                  >
                    <span>Get Quote</span>
                    <span class="material-symbols-outlined text-[13px]">arrow_forward</span>
                  </a>
                </div>

              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- ── CTA ── -->
    <section class="py-20 bg-gradient-to-r from-[#001026] to-[#0b2545] text-white">
      <div class="max-w-4xl mx-auto px-6 lg:px-12 text-center">
        <span class="material-symbols-outlined text-[#ffdf9f] text-5xl mb-4 block">diamond</span>
        <h2 class="text-3xl lg:text-4xl font-bold text-white mb-4">Ready to Restore the Luxury of Your Floors?</h2>
        <p class="text-white/80 text-lg mb-8 max-w-2xl mx-auto">
          100% free on-site assessment across all Hafar Al-Batin districts with a live 1 m² test patch.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a href={`https://wa.me/${SITE.waNumber}?text=${encodeURIComponent('Hello, I would like to book a free stone inspection in Hafar Al-Batin via jaliblaathafar.com')}`} target="_blank" rel="noopener"
             class="inline-flex items-center justify-center gap-2 bg-[#25D366] text-white hover:bg-[#20bd5a] transition-all px-8 py-4 rounded-xl font-bold text-base shadow-lg">
            <span class="material-symbols-outlined">chat</span>
            WhatsApp Instant Quote
          </a>
          <a href={`tel:${SITE.phone}`}
             class="inline-flex items-center justify-center gap-2 bg-white/10 hover:bg-white/20 text-white border border-white/30 transition-all px-8 py-4 rounded-xl font-bold text-base">
            <span class="material-symbols-outlined">call</span>
            Call: 053 981 1299
          </a>
        </div>
      </div>
    </section>
  </main>

  <Footer lang="en" />
  <MobileCTABar lang="en" />
</BaseLayout>
