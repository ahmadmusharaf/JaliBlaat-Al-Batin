---
// src/pages/404.astro
import PageLayout from '../layouts/PageLayout.astro';
import { SITE, sitePath, waLink } from '../data/site';

// Detect language from URL prefix
const isEn = Astro.url.pathname.startsWith('/en');
const lang = isEn ? 'en' : 'ar';
---

<PageLayout
  title={isEn ? '404 — Page Not Found | JaliBlaat Al Batin' : '404 — الصفحة غير موجودة | جلي بلاط حفرالباطن'}
  description={isEn ? 'Page not found' : 'الصفحة المطلوبة غير موجودة'}
  lang={lang}
>
  <div class="min-h-[60vh] flex items-center justify-center px-6 py-20">
    <div class="text-center max-w-md">
      <div class="text-8xl font-bold text-[#e5e2db] font-['Inter'] mb-6">404</div>
      <span class="material-symbols-outlined text-[64px] text-[#735b24] block mb-6">search_off</span>
      <h1 class="text-2xl font-bold text-[#001026] mb-4">
        {isEn ? 'Page not found' : 'الصفحة غير موجودة'}
      </h1>
      <p class="text-[#44474e] mb-8">
        {isEn
          ? 'The page you\'re looking for doesn\'t exist. Try our homepage or contact us via WhatsApp.'
          : 'الصفحة التي تبحث عنها غير موجودة. جرّب الرئيسية أو تواصل معنا عبر الواتساب.'}
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href={isEn ? sitePath('/en/') : sitePath('/')}
           class="inline-flex items-center justify-center gap-2 bg-[#001026] text-white px-6 py-3 rounded font-bold text-sm font-['Inter'] hover:bg-[#0b2545] transition-colors">
          <span class="material-symbols-outlined text-[18px]">home</span>
          {isEn ? 'Go Home' : 'الرئيسية'}
        </a>
        <a href={waLink(lang)} target="_blank" rel="noopener"
           class="inline-flex items-center justify-center gap-2 bg-[#25D366] text-white px-6 py-3 rounded font-bold text-sm font-['Inter'] hover:brightness-110 transition-all">
          <span class="material-symbols-outlined text-[18px]">chat</span>
          WhatsApp
        </a>
      </div>
    </div>
  </div>
</PageLayout>
