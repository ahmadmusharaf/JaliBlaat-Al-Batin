---
// src/layouts/BaseLayout.astro
import '../styles/global.css';
import { SITE, waLink } from '../data/site';

export interface Props {
  title: string;
  description: string;
  lang?: 'ar' | 'en';
  dir?: 'rtl' | 'ltr';
  canonical?: string;
  ogImage?: string;
  schemaJson?: string;
  currentPage?: string; // e.g. 'home' | 'services' | 'our-work' | 'pricing' | 'service-areas' | 'contact'
}

const {
  title,
  description,
  lang = 'ar',
  dir = lang === 'en' ? 'ltr' : 'rtl',
  canonical,
  ogImage = '/images/og-default.jpg',
  schemaJson,
  currentPage = '',
} = Astro.props;

const canonicalUrl = canonical ?? SITE.url + Astro.url.pathname;
---

<!doctype html>
<html {dir} {lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#0b2545" />

    <!-- Primary SEO -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={lang === 'ar' ? 'جلي بلاط حفر الباطن, رقم جلي بلاط بحفر الباطن, جلي رخام حفر الباطن, شركة جلي بلاط بحفر الباطن, معلم جلي بلاط حفر الباطن, تلميع سيراميك وبورسلان حفر الباطن, اسعار جلي البلاط حفر الباطن, كلياندكس إيطالي, 0539811299, jaliblaathafar.com' : 'tile polishing hafar al batin, marble polishing hafar al batin, floor polishing saudi arabia, terrazzo restoration, 0539811299, jaliblaathafar.com'} />
    <meta name="google-site-verification" content="d7b4c0bd8ab9559a" />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Open Graph -->
    <meta property="og:type"        content="website" />
    <meta property="og:url"         content={canonicalUrl} />
    <meta property="og:title"       content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image"       content={SITE.url + ogImage} />
    <meta property="og:locale"      content={lang === 'ar' ? 'ar_SA' : 'en_US'} />
    <meta property="og:site_name"   content="JaliBlaat Al Batin" />

    <!-- Twitter Card -->
    <meta name="twitter:card"        content="summary_large_image" />
    <meta name="twitter:title"       content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image"       content={SITE.url + ogImage} />

    <!-- Hreflang alternates -->
    <link rel="alternate" hreflang="ar" href={SITE.url + '/'} />
    <link rel="alternate" hreflang="en" href={SITE.url + '/en/'} />
    <link rel="alternate" hreflang="x-default" href={SITE.url + '/'} />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Fonts: preconnect first for perf -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+Arabic:wght@400;500;600;700&family=IBM+Plex+Sans:wght@400;500;600;700&family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <!-- Material Symbols — only the weight/fill we need -->
    <link
      href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0"
      rel="stylesheet"
    />

    <!-- Structured Data -->
    {schemaJson && <script type="application/ld+json" set:html={schemaJson} />}
  </head>

  <body class="min-h-screen flex flex-col">
    <slot />

    <!-- ── Floating WhatsApp FAB (visible on all pages) ── -->
    <a href={waLink(lang as 'ar' | 'en')}
       target="_blank" rel="noopener noreferrer"
       class="wa-fab"
       aria-label={lang === 'ar' ? 'تواصل عبر واتساب' : 'Contact via WhatsApp'}>
      <!-- WhatsApp SVG icon -->
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="28" height="28" fill="white" aria-hidden="true">
        <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
      </svg>
    </a>

    <!-- ── Mobile Click-to-Call floating button (mobile only, appears after scroll) ── -->
    <a href={`tel:${SITE.phone}`}
       id="mobile-call-btn"
       class="fixed bottom-24 left-4 z-[89] md:hidden w-14 h-14 rounded-full bg-[#001026] text-white flex items-center justify-center shadow-lg call-pulse-mobile opacity-0 translate-y-4 transition-all duration-300"
       aria-label={lang === 'ar' ? 'اتصل بنا' : 'Call us'}>
      <span class="material-symbols-outlined text-2xl">call</span>
    </a>
  </body>

  <!-- ── Scroll-reveal observer (runs once, tiny JS) ── -->
  <script>
    // Scroll animations
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.12, rootMargin: '0px 0px -40px 0px' }
    );
    document.querySelectorAll('.reveal, .reveal-left, .reveal-right, .reveal-scale')
      .forEach(el => observer.observe(el));

    // Lazy image fade-in
    document.querySelectorAll('img[loading="lazy"]').forEach(img => {
      if ((img as HTMLImageElement).complete) {
        img.classList.add('loaded');
      } else {
        img.addEventListener('load', () => img.classList.add('loaded'));
      }
    });

    // Mobile click-to-call button — appears after scrolling 300px
    const callBtn = document.getElementById('mobile-call-btn');
    if (callBtn && window.innerWidth < 768) {
      window.addEventListener('scroll', () => {
        if (window.scrollY > 300) {
          callBtn.style.opacity = '1';
          callBtn.style.transform = 'translateY(0)';
        } else {
          callBtn.style.opacity = '0';
          callBtn.style.transform = 'translateY(16px)';
        }
      }, { passive: true });
    }

    // Swipe dots sync
    const swipeRow = document.querySelector('.swipe-row') as HTMLElement | null;
    const dots = document.querySelectorAll('.snap-dot');
    if (swipeRow && dots.length > 0) {
      swipeRow.addEventListener('scroll', () => {
        const cardWidth = (swipeRow.querySelector('.swipe-card') as HTMLElement)?.offsetWidth + 16 || 1;
        const index = Math.round(swipeRow.scrollLeft / cardWidth);
        dots.forEach((d, i) => d.classList.toggle('active', i === index));
      }, { passive: true });
    }
  </script>
</html>
