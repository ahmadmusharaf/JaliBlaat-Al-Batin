---
// src/components/sections/Services.astro
import { SITE, sitePath } from '../../data/site';

export interface Props {
  lang?: 'ar' | 'en';
}
const { lang = 'ar' } = Astro.props;
const isAr = lang === 'ar';

const services = [
  {
    icon: 'diamond',
    icon2: 'verified',
    image: '/images/client/marble-majlis.jpg',
    ar: {
      title: 'جلي وترميم الرخام الطبيعي',
      desc: 'جلي وتلميع رخام كريم ماربل، تراورتين، وكريستال بأقراص الألماس المائي والكريستلايزر الإيطالي لإعطاء لمعان مرآتي فندقي يدوم لسنوات.',
      duration: '4–8 ساعات / 100 م²'
    },
    en: {
      title: 'Marble Polishing & Restoration',
      desc: 'Our diamond-grinding process removes scratches and restores the deep mirror shine of Italian and local marble floors and walls.',
      duration: '4–8 hours / 100 m²'
    },
  },
  {
    icon: 'crop_square',
    icon2: 'cleaning_services',
    image: '/images/client/stairs-marble.jpg',
    ar: {
      title: 'جلي السيراميك والبورسلان',
      desc: 'تنظيف عميق وجلي متخصص للبلاط والسيراميك والبورسلان لإزالة الترسبات الكلسية وتبييض الترويبة وتطبيق معالجة مانعة للانزلاق.',
      duration: '3–6 ساعات / 100 م²'
    },
    en: {
      title: 'Ceramic & Porcelain Tile Polishing',
      desc: 'Specialised deep cleaning and polishing for ceramic, porcelain, and glazed tiles, leaving floors bright, hygienic, and easy to clean.',
      duration: '3–6 hours / 100 m²'
    },
  },
  {
    icon: 'texture',
    icon2: 'auto_awesome',
    image: '/images/client/commercial-hall.jpg',
    ar: {
      title: 'طحن وتلميع التيرازو والبلاط',
      desc: 'تسوية الأسطح غير المستوية، معالجة التشققات، وطحن ماسي رطب بدون غبار لبلورة أرضيات التيرازو والبلاط إلى أعلى درجات اللمعان.',
      duration: '5–10 ساعات / 100 م²'
    },
    en: {
      title: 'Terrazzo Grinding & Polishing',
      desc: 'Wet diamond grinding levels uneven surfaces, repairs cracks, and delivers a flawless, hygienic high-gloss crystallised finish.',
      duration: '5–10 hours / 100 m²'
    },
  },
  {
    icon: 'panorama_horizontal',
    icon2: 'shield',
    image: '/images/client/onyx-bathroom.jpg',
    ar: {
      title: 'تلميع وتغليف الجرانيت والرخام الديكوري',
      desc: 'استعادة البريق العميق للجرانيت والرخام بأقراص الألماس المخصصة وتطبيق مواد نفاذة تحميه من امتصاص الزيوت، القهوة، والبقع بشكل دائم.',
      duration: '3–5 ساعات / 100 م²'
    },
    en: {
      title: 'Granite & Decorative Stone Polishing',
      desc: 'Penetrating sealants and diamond polishing bring back the rich lustre of granite and stone surfaces while permanently protecting against stains.',
      duration: '3–5 hours / 100 m²'
    },
  },
  {
    icon: 'square_foot',
    icon2: 'eco',
    image: '/images/client/commercial-washroom.jpg',
    ar: {
      title: 'ترميم مغاسل الرخام والحجر الجيري',
      desc: 'صقل لطيف بمركبات مخصصة لحماية البنية البلورية الرقيقة للحجر، مع ملء الفراغات وتطبيق مادة عازلة متنفّسة عالية الجودة للمغاسل والأحواض.',
      duration: '5–8 ساعات / 100 م²'
    },
    en: {
      title: 'Marble Basins & Limestone Restoration',
      desc: 'Gentle low-pH diamond honing, void-filling for marble washbasins, and breathable natural-look protective sealing.',
      duration: '5–8 hours / 100 m²'
    },
  },
  {
    icon: 'foundation',
    icon2: 'construction',
    image: '/images/client/villa-hall.jpg',
    ar: {
      title: 'جلي صالات الاستقبال والبهو الفاخر',
      desc: 'تحويل الأرضيات والصالات الكبيرة إلى أسطح بلورية كريستالية متينة بدون فواصل بارزة، مقاومة للأتربة وسهلة التنظيف اليومي.',
      duration: '1–2 يوم / 100 م²'
    },
    en: {
      title: 'Grand Hall & Foyer Floor Polishing',
      desc: 'Transforming large halls and reception floors into seamless crystallised mirror surfaces, dust-resistant and easy to maintain.',
      duration: '1–2 days / 100 m²'
    },
  },
];
---

<section id="services" class="w-full bg-[#fcf9f2] py-20 lg:py-28">
  <div class="max-w-7xl mx-auto px-6 lg:px-12">

    <!-- Section header -->
    <div class="text-center mb-14">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-[#fedb98] text-[#785f28] text-xs font-bold font-['Inter'] mb-4 shadow-sm">
        <span class="material-symbols-outlined text-[15px]">diamond</span>
        {isAr ? 'خدمات معتمدة لجميع أنواع الأرضيات' : 'Certified Craftsmanship for All Floors'}
      </div>
      <h2 class="text-3xl lg:text-5xl font-bold text-[#001026] tracking-tight mb-4">
        {isAr ? 'خدمات جلي وترميم متخصصة لأرضياتك' : 'Specialized Floor Polishing & Restoration'}
      </h2>
      <p class="text-base md:text-lg text-[#44474e] max-w-2xl mx-auto leading-relaxed">
        {isAr
          ? 'نقدم حلولاً هندسية متكاملة لجلي وترميم الحجر والرخام بمعايير فندقية وبأحدث ماكينات كلياندكس الإيطالية في جميع أحياء حفر الباطن.'
          : 'Complete precision stone restoration and hotel-grade polishing using Italian Klindex machinery across Hafar Al-Batin.'}
      </p>
    </div>

    <!-- Services grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {services.map(svc => (
        <div class="group bg-white border border-[#e5e2db] rounded-2xl overflow-hidden shadow-sm
                    hover:shadow-xl hover:-translate-y-1.5 hover:border-[#735b24]/40
                    transition-all duration-300 flex flex-col justify-between">
          
          <!-- Card Image Header -->
          <div class="relative h-48 overflow-hidden bg-[#001026]">
            <img
              src={svc.image}
              alt={isAr ? svc.ar.title : svc.en.title}
              loading="lazy"
              class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500 ease-out"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-[#001026] via-[#001026]/30 to-transparent"></div>
            
            <!-- Badges -->
            <div class="absolute top-3.5 inset-x-3.5 flex items-center justify-between pointer-events-none">
              <span class="w-9 h-9 rounded-xl bg-[#001026]/80 backdrop-blur-md text-[#ffdf9f] flex items-center justify-center border border-white/10 shadow-md">
                <span class="material-symbols-outlined text-xl">{svc.icon}</span>
              </span>
              <span class="w-7 h-7 rounded-lg bg-white/20 backdrop-blur-md text-[#ffdf9f] flex items-center justify-center border border-white/20">
                <span class="material-symbols-outlined text-sm">{svc.icon2}</span>
              </span>
            </div>

            <!-- Title Overlay -->
            <div class="absolute bottom-3.5 inset-x-3.5 pointer-events-none">
              <h3 class="text-white font-bold text-lg leading-tight drop-shadow-md">
                {isAr ? svc.ar.title : svc.en.title}
              </h3>
            </div>
          </div>

          <!-- Content -->
          <div class="p-6 flex flex-col justify-between flex-1">
            <p class="text-sm text-[#44474e] leading-relaxed mb-5">
              {isAr ? svc.ar.desc : svc.en.desc}
            </p>

            <div class="pt-4 border-t border-[#e5e2db] flex items-center justify-between">
              <span class="text-xs text-[#74777f] flex items-center gap-1">
                <span class="material-symbols-outlined text-[14px] text-[#735b24]">schedule</span>
                <span>{isAr ? svc.ar.duration : svc.en.duration}</span>
              </span>

              <a
                href={`https://wa.me/${SITE.waNumber}?text=${encodeURIComponent(isAr ? 'السلام عليكم، أود الاستفسار عن خدمة ' + svc.ar.title + ' بحفر الباطن عبر jaliblaathafar.com' : 'Hello, I would like to inquire about ' + svc.en.title + ' via jaliblaathafar.com')}`}
                target="_blank"
                rel="noopener"
                class="inline-flex items-center gap-1 text-xs font-bold font-['Inter'] text-[#002c0f] bg-[#66ff8e]/20 hover:bg-[#002c0f] hover:text-[#66ff8e] px-3 py-1.5 rounded-lg transition-colors border border-[#002c0f]/20"
              >
                <span>{isAr ? 'اطلب تسعير' : 'Get Quote'}</span>
                <span class="material-symbols-outlined text-[12px]">{isAr ? 'arrow_back' : 'arrow_forward'}</span>
              </a>
            </div>
          </div>

        </div>
      ))}
    </div>

    <!-- View All Services CTA Button -->
    <div class="mt-14 text-center">
      <a
        href={isAr ? sitePath('/ar/services/') : sitePath('/en/services/')}
        class="inline-flex items-center gap-2 bg-[#001026] text-white hover:bg-[#0b2545] transition-all px-8 py-4 rounded-xl text-sm font-bold shadow-md hover:shadow-lg"
      >
        <span>{isAr ? 'استعرض تفاصيل خطوات العمل لجميع الخدمات' : 'View Full Technical Process For All Services'}</span>
        <span class="material-symbols-outlined text-base">{isAr ? 'arrow_back' : 'arrow_forward'}</span>
      </a>
    </div>

  </div>
</section>
