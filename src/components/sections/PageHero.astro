---
// src/components/sections/PageHero.astro
// Reusable inner-page hero — used by Services, Our Work, Service Areas, Contact pages

export interface Props {
  title: string;
  subtitle?: string;
  badge?: string;
  breadcrumb?: { label: string; href?: string }[];
  bg?: 'navy' | 'warm' | 'emerald';
  lang?: 'ar' | 'en';
  accentIcon?: string;
}

const {
  title,
  subtitle,
  badge,
  breadcrumb = [],
  bg = 'navy',
  lang = 'ar',
  accentIcon = 'star',
} = Astro.props;

const isAr = lang === 'ar';

const bgClasses = {
  navy:    'bg-gradient-to-br from-[#001026] via-[#0b2545] to-[#001a40]',
  warm:    'bg-gradient-to-br from-[#1a1200] via-[#2a1e00] to-[#3d2d08]',
  emerald: 'bg-gradient-to-br from-[#001404] via-[#002c0f] to-[#003a14]',
};

const accentClasses = {
  navy:    'from-[#735b24]/30 to-[#c8a96a]/10',
  warm:    'from-[#735b24]/40 to-[#fedb98]/10',
  emerald: 'from-[#25D366]/20 to-[#66ff8e]/10',
};
---

<section class={`relative min-h-[42vh] flex items-end pb-16 pt-36 overflow-hidden ${bgClasses[bg]}`}>
  <!-- Decorative radial blobs -->
  <div class="pointer-events-none absolute inset-0 overflow-hidden" aria-hidden="true">
    <div class={`absolute -top-20 ${isAr ? '-right-20' : '-left-20'} w-96 h-96 rounded-full bg-gradient-to-br ${accentClasses[bg]} blur-3xl`}></div>
    <div class={`absolute bottom-0 ${isAr ? '-left-16' : '-right-16'} w-72 h-72 rounded-full bg-gradient-to-tl ${accentClasses[bg]} blur-2xl opacity-60`}></div>
    <!-- Grid pattern overlay -->
    <div class="absolute inset-0 opacity-[0.04]"
         style="background-image: linear-gradient(rgba(255,255,255,0.4) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,0.4) 1px, transparent 1px); background-size: 50px 50px;">
    </div>
  </div>

  <div class="relative z-10 max-w-7xl mx-auto px-6 lg:px-12 w-full">
    <!-- Breadcrumb -->
    {breadcrumb.length > 0 && (
      <nav aria-label={isAr ? 'مسار التنقل' : 'Breadcrumb'} class="mb-5 reveal">
        <ol class="flex flex-wrap items-center gap-2 text-xs font-medium text-white/50">
          {breadcrumb.map((crumb, i) => (
            <>
              {i > 0 && <li class="opacity-40">{isAr ? '‹' : '›'}</li>}
              <li>
                {crumb.href
                  ? <a href={crumb.href} class="hover:text-white/80 transition-colors">{crumb.label}</a>
                  : <span class="text-white/80">{crumb.label}</span>
                }
              </li>
            </>
          ))}
        </ol>
      </nav>
    )}

    <!-- Badge -->
    {badge && (
      <div class="mb-5 reveal">
        <span class="inline-flex items-center gap-2 text-xs font-bold uppercase tracking-[0.15em] text-[#ffdf9f] bg-[#735b24]/20 border border-[#735b24]/30 px-4 py-1.5 rounded-full">
          <span class="material-symbols-outlined text-[14px]">{accentIcon}</span>
          {badge}
        </span>
      </div>
    )}

    <!-- Title -->
    <h1 class={`text-3xl sm:text-4xl lg:text-5xl font-bold text-white leading-tight mb-4 reveal ${isAr ? 'font-[IBM_Plex_Sans_Arabic]' : ''}`}
        style="text-shadow: 0 2px 20px rgba(0,0,0,0.3);">
      {title}
    </h1>

    <!-- Subtitle -->
    {subtitle && (
      <p class="text-base sm:text-lg text-white/70 max-w-2xl leading-relaxed reveal">
        {subtitle}
      </p>
    )}

    <!-- Gold decorative line -->
    <div class="mt-8 w-16 h-1 bg-gradient-to-r from-[#c8a96a] to-[#735b24] rounded-full reveal"></div>
  </div>
</section>
