---
// src/components/sections/PricingHero.astro
// Used on the pricing pages (AR + EN)
import { SITE, waLink } from '../../data/site';

export interface Props { lang?: 'ar' | 'en'; }
const { lang = 'ar' } = Astro.props;
const isAr = lang === 'ar';
---

<section class="relative w-full bg-[#fcf9f2] pt-10 pb-20 lg:pt-16 lg:pb-28 overflow-hidden">
  <!-- Subtle dot grid -->
  <div class="absolute inset-0 opacity-[0.03] pointer-events-none"
       style="background-image:radial-gradient(#0b2545 1px,transparent 1px);background-size:24px 24px;"></div>

  <div class="max-w-7xl mx-auto px-6 lg:px-12 relative z-10">

    <!-- Breadcrumb -->
    <nav class="flex items-center gap-2 text-xs text-[#44474e] mb-10 font-['Inter']">
      <a href={isAr ? '/' : '/en/'} class="hover:text-[#001026] flex items-center gap-1 transition-colors">
        <span class="material-symbols-outlined text-[14px]">home</span>
        {isAr ? 'الرئيسية' : 'Home'}
      </a>
      <span class="material-symbols-outlined text-[13px] text-[#c4c6cf]">{isAr ? 'arrow_back_ios' : 'arrow_forward_ios'}</span>
      <span class="text-[#735b24] font-semibold">{isAr ? 'أسعار الجلي' : 'Polishing Prices'}</span>
      <span class="ms-auto flex items-center gap-1.5 bg-[#f0eee7] px-3 py-1 rounded text-[10px] font-semibold hidden lg:flex">
        <span class="w-1.5 h-1.5 rounded-full bg-[#3de273] animate-pulse"></span>
        {isAr ? 'أسعار محدّثة 2025' : 'Updated 2025 Prices'}
      </span>
    </nav>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-center">

      <!-- Text column -->
      <div class="lg:col-span-7 flex flex-col gap-6">
        <div class="inline-flex items-center gap-2 self-start px-3.5 py-1.5 rounded-full bg-[#f0eee7] text-[#735b24] text-xs font-bold font-['Inter']">
          <span class="material-symbols-outlined text-[16px]">verified</span>
          {isAr ? 'دليل الشفافية الحصري للأسعار 2025' : 'Exclusive 2025 Price Transparency Guide'}
        </div>

        <h1 class="text-4xl lg:text-5xl font-bold text-[#001026] tracking-tight leading-tight">
          {isAr
            ? 'كم سعر جلي البلاط والرخام في حفر الباطن؟'
            : 'How Much Does Tile & Marble Polishing Cost in Hafar Al-Batin?'}
        </h1>

        <p class="text-lg text-[#44474e] max-w-2xl leading-relaxed">
          {isAr
            ? 'دليل شفاف وشامل لأسعار المتر المربع بدون تكاليف خفية — مع إمكانية الحصول على تسعير فوري بإرسال صور أرضيتك عبر الواتساب.'
            : 'A complete, transparent guide to per-m² pricing with no hidden costs — get an instant quote by sending photos of your floor via WhatsApp.'}
        </p>

        <!-- Price matrix -->
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
          {[
            { label_ar: 'متوسط المتر السكني', label_en: 'Residential Rate',
              value: '12–35', unit_ar: 'ر.س / م²', unit_en: 'SAR / m²',
              note_ar: 'حسب النوع والحالة', note_en: 'By type & condition' },
            { label_ar: 'المعاينة الميدانية', label_en: 'On-Site Inspection',
              value: 'مجانية', value_en: 'FREE', unit_ar: '100%', unit_en: '100%',
              note_ar: 'تشمل عينة تجريبية', note_en: 'Includes test sample' },
            { label_ar: 'الضمان المعتمد',    label_en: 'Certified Warranty',
              value: '10', unit_ar: 'سنوات لمعان', unit_en: 'yrs shine',
              note_ar: 'مع طبقة النانو الإيطالية', note_en: 'With Italian nano layer' },
          ].map(p => (
            <div class="bg-[#f6f3ec] p-5 rounded-xl shadow-sm border border-[rgba(200,169,106,0.2)]">
              <div class="text-xs font-bold font-['Inter'] text-[#735b24] mb-2 uppercase tracking-wide">
                {isAr ? p.label_ar : p.label_en}
              </div>
              <div class="flex items-baseline gap-1 mb-1">
                <span class="text-3xl font-bold text-[#001026] font-['Inter']">
                  {isAr ? p.value : (p.value_en ?? p.value)}
                </span>
                <span class="text-sm text-[#44474e]">{isAr ? p.unit_ar : p.unit_en}</span>
              </div>
              <p class="text-xs text-[#44474e]">{isAr ? p.note_ar : p.note_en}</p>
            </div>
          ))}
        </div>

        <!-- CTAs -->
        <div class="flex flex-wrap items-center gap-4">
          <a href={waLink(lang)} target="_blank" rel="noopener"
             class="inline-flex items-center gap-3 bg-[#002c0f] text-[#66ff8e] hover:bg-[#001404]
                    px-6 py-4 rounded font-bold text-sm font-['Inter'] shadow-md transition-all wa-pulse">
            <span class="material-symbols-outlined text-[20px]">chat</span>
            {isAr ? 'تسعير فوري بإرسال صور أرضيتك' : 'Instant quote — send your floor photos'}
          </a>
          <a href="#calculator"
             class="inline-flex items-center gap-2 bg-[#f0eee7] text-[#001026] hover:bg-[#e5e2db]
                    px-6 py-4 rounded font-bold text-sm font-['Inter'] transition-colors">
            <span class="material-symbols-outlined text-[18px]">calculate</span>
            {isAr ? 'احسب تكلفة مشروعك' : 'Calculate your project cost'}
          </a>
        </div>
      </div>

      <!-- Visual card -->
      <div class="lg:col-span-5 relative">
        <div class="relative rounded-2xl overflow-hidden shadow-2xl bg-[#f0eee7] h-[380px]">
          <img src="/images/pricing-marble.jpg"
               alt={isAr ? 'جلي رخام فاخر بحفر الباطن' : 'Luxury marble polishing Hafar Al-Batin'}
               class="w-full h-full object-cover"
               loading="eager"
               onerror="this.style.display='none'" />
          <!-- Fallback gradient -->
          <div class="absolute inset-0 bg-gradient-to-br from-[#0b2545] via-[#001026] to-[#735b24] flex items-center justify-center">
            <div class="text-center text-white/70">
              <span class="material-symbols-outlined text-[72px] block mb-3">diamond</span>
              <div class="text-sm font-['Inter']">{isAr ? 'صورة المشروع' : 'Project Photo'}</div>
            </div>
          </div>
          <!-- Bottom overlay -->
          <div class="absolute inset-0 bg-gradient-to-t from-[#001026]/90 via-transparent to-transparent flex flex-col justify-end p-7 text-white">
            <span class="inline-block bg-[#735b24] text-white text-xs font-bold font-['Inter'] px-3 py-1 rounded mb-2 self-start">
              {isAr ? 'جلي أقراص الألماس المائي' : 'Water-diamond disc polishing'}
            </span>
            <p class="font-bold text-base">{isAr ? 'تسوية الليباج بدقة المليمتر' : 'Millimeter-precise lippage levelling'}</p>
            <p class="text-xs text-white/70 mt-1">
              {isAr ? 'بأجهزة Klindex الإيطالية خالية من الغبار' : 'Italian Klindex machines — 100% dust-free'}
            </p>
          </div>
          <!-- Floating pill -->
          <div class="absolute -bottom-5 start-5 hidden sm:flex items-center gap-3 bg-white p-4 rounded-xl shadow-xl text-[#001026]">
            <div class="w-11 h-11 rounded bg-[#fedb98] flex items-center justify-center text-[#735b24]">
              <span class="material-symbols-outlined text-[24px]">diamond</span>
            </div>
            <div>
              <div class="font-bold text-sm">{isAr ? '6 مراحل' : '6 Stages'}</div>
              <div class="text-xs text-[#44474e]">{isAr ? 'صقل وتلميع بالكريستال الحراري' : 'Diamond grinding to crystallizer'}</div>
            </div>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>
