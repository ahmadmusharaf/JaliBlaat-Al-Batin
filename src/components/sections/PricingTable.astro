---
// src/components/sections/PricingTable.astro
import { waLink } from '../../data/site';

export interface Props { lang?: 'ar' | 'en'; }
const { lang = 'ar' } = Astro.props;
const isAr = lang === 'ar';

const rows = [
  { type_ar: 'جلي الرخام الطبيعي والكريستال',    type_en: 'Natural Marble & Crystal Polish',
    range: '20–35', unit: 'SAR/m²', time_ar: '2–4 أيام',   time_en: '2–4 days',
    machine_ar: 'Klindex Planex + كريستلايزر',  machine_en: 'Klindex Planex + Crystallizer',
    note_ar: 'ضمان 10 سنوات', note_en: '10-year warranty' },
  { type_ar: 'جلي البورسلان والسيراميك',          type_en: 'Porcelain & Ceramic Polish',
    range: '15–25', unit: 'SAR/m²', time_ar: '1–3 أيام',   time_en: '1–3 days',
    machine_ar: 'مطرقة ألماسية + صقل سطحي',    machine_en: 'Diamond hammer + surface buff',
    note_ar: 'بدون غبار', note_en: 'Zero dust' },
  { type_ar: 'جلي البلاط العادي والجريس',         type_en: 'Standard Tile & Terrazzo Polish',
    range: '12–20', unit: 'SAR/m²', time_ar: '1–2 يوم',    time_en: '1–2 days',
    machine_ar: 'مكينة جلي + تلميع',           machine_en: 'Polish machine + buffing',
    note_ar: 'تلميع سريع', note_en: 'Fast polish' },
  { type_ar: 'تنظيف عميق وتجريد الطلاء',          type_en: 'Deep Scrubbing & Coating Removal',
    range: '10–18', unit: 'SAR/m²', time_ar: '1–2 يوم',    time_en: '1–2 days',
    machine_ar: 'جلاخة + مواد صناعية',         machine_en: 'Grinder + industrial chemicals',
    note_ar: 'آمن للأطفال', note_en: 'Child-safe' },
  { type_ar: 'إصلاح الفواصل بالإيبوكسي',          type_en: 'Epoxy Grout Repair',
    range: '5–12',  unit: 'SAR/m',  time_ar: 'نفس اليوم',  time_en: 'Same day',
    machine_ar: 'مواد إيبوكسي إيطالية',        machine_en: 'Italian epoxy compounds',
    note_ar: 'ضد الرطوبة', note_en: 'Moisture-proof' },
  { type_ar: 'طلاء النانو الواقي',                type_en: 'Nano Protective Coating',
    range: '8–15',  unit: 'SAR/m²', time_ar: 'ساعات',       time_en: 'Hours',
    machine_ar: 'نانو إيطالي شفاف',            machine_en: 'Transparent Italian nano',
    note_ar: 'حماية 10 سنوات', note_en: '10-yr protection' },
];
---

<section id="pricing-table" class="w-full bg-[#f6f3ec] py-20 lg:py-24">
  <div class="max-w-7xl mx-auto px-6 lg:px-12">

    <div class="text-center mb-12">
      <h2 class="text-3xl font-bold text-[#001026] mb-3">
        {isAr ? 'جدول أسعار وموصفات جلي الأرضيات في حفر الباطن 2025' : '2025 Polishing Rates & Specifications — Hafar Al-Batin'}
      </h2>
      <p class="text-[#44474e] max-w-2xl mx-auto text-sm">
        {isAr
          ? 'جميع الأسعار بالريال السعودي للمتر المربع. يتغير السعر بحسب حالة الأرضية والمساحة الكلية.'
          : 'All prices in SAR per m². Final price varies based on floor condition and total area.'}
      </p>
    </div>

    <!-- Responsive table -->
    <div class="overflow-x-auto rounded-2xl shadow-md border border-[rgba(200,169,106,0.2)]">
      <table class="w-full text-sm border-collapse">
        <thead>
          <tr class="bg-[#001026] text-white text-xs font-semibold font-['Inter'] uppercase tracking-wider">
            <th class="text-start px-5 py-4">{isAr ? 'نوع الخدمة' : 'Service Type'}</th>
            <th class="text-center px-5 py-4">{isAr ? 'السعر (ر.س / م²)' : 'Price (SAR/m²)'}</th>
            <th class="text-center px-5 py-4 hidden md:table-cell">{isAr ? 'المدة' : 'Duration'}</th>
            <th class="text-center px-5 py-4 hidden lg:table-cell">{isAr ? 'المعدات' : 'Equipment'}</th>
            <th class="text-center px-5 py-4">{isAr ? 'المميزات' : 'Feature'}</th>
          </tr>
        </thead>
        <tbody>
          {rows.map((row, i) => (
            <tr class={`border-b border-[#e5e2db] ${i % 2 === 0 ? 'bg-white' : 'bg-[#fcf9f2]'} hover:bg-[#f6f3ec] transition-colors`}>
              <td class="px-5 py-4 font-semibold text-[#001026]">{isAr ? row.type_ar : row.type_en}</td>
              <td class="px-5 py-4 text-center">
                <span class="inline-block bg-[#fedb98] text-[#785f28] font-bold font-['Inter'] px-3 py-1 rounded">
                  {row.range} {row.unit}
                </span>
              </td>
              <td class="px-5 py-4 text-center text-[#44474e] hidden md:table-cell">
                {isAr ? row.time_ar : row.time_en}
              </td>
              <td class="px-5 py-4 text-center text-[#44474e] hidden lg:table-cell text-xs">
                {isAr ? row.machine_ar : row.machine_en}
              </td>
              <td class="px-5 py-4 text-center">
                <span class="inline-flex items-center gap-1 text-xs font-semibold text-[#735b24]">
                  <span class="material-symbols-outlined text-[13px]">verified</span>
                  {isAr ? row.note_ar : row.note_en}
                </span>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <!-- Footnote + CTA -->
    <div class="mt-8 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
      <p class="text-xs text-[#74777f] flex items-center gap-1.5">
        <span class="material-symbols-outlined text-[14px]">info</span>
        {isAr
          ? '* الأسعار تقديرية. التسعير الدقيق يتطلب معاينة ميدانية أو صور تفصيلية عبر الواتساب.'
          : '* Prices are estimates. Exact pricing requires an on-site inspection or detailed WhatsApp photos.'}
      </p>
      <a href={waLink(lang)} target="_blank" rel="noopener"
         class="inline-flex items-center gap-2 bg-[#001026] text-white px-5 py-3 rounded font-bold text-sm font-['Inter'] hover:bg-[#0b2545] transition-colors shrink-0">
        <span class="material-symbols-outlined text-[18px]">chat</span>
        {isAr ? 'احصل على عرض سعر مجاني' : 'Get a Free Quote'}
      </a>
    </div>

  </div>
</section>
