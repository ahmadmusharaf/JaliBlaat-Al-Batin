---
// src/components/Header.astro
// Bilingual sticky header — renders Arabic or English version based on `lang` prop
import { SITE, waLink } from '../data/site';

export interface Props {
  lang?: 'ar' | 'en';
  currentPath?: string;
}

const { lang = 'ar', currentPath = '/' } = Astro.props;
const isAr = lang === 'ar';

const navLinks = isAr
  ? [
      { href: '/',             label: 'الرئيسية',       key: 'home' },
      { href: '/#services',    label: 'خدماتنا',        key: 'services' },
      { href: '/#our-work',    label: 'أعمالنا',        key: 'our-work' },
      { href: '/ar/pricing/',  label: 'أسعار الجلي',    key: 'pricing' },
      { href: '/#service-areas', label: 'مناطق الخدمة', key: 'areas' },
      { href: '/#contact',     label: 'اتصل بنا',       key: 'contact' },
    ]
  : [
      { href: '/en/',             label: 'Home',          key: 'home' },
      { href: '/en/#services',    label: 'Services',      key: 'services' },
      { href: '/en/#our-work',    label: 'Our Work',      key: 'our-work' },
      { href: '/en/pricing/',     label: 'Pricing',       key: 'pricing' },
      { href: '/en/#service-areas', label: 'Service Areas', key: 'areas' },
      { href: '/en/#contact',     label: 'Contact',       key: 'contact' },
    ];

const switchLang = isAr ? { href: '/en/', label: 'English' } : { href: '/', label: 'العربية' };
---

<header class="fixed top-0 inset-x-0 z-50 shadow-[0_1px_8px_rgba(11,37,69,0.06)]">

  <!-- ── Top micro-bar ── -->
  <div class="bg-[#0b2545] text-white/90 hidden md:block text-xs font-medium font-['Inter']">
    <div class="max-w-7xl mx-auto px-6 lg:px-12 h-10 flex items-center justify-between gap-4">

      <div class="flex items-center gap-5 overflow-hidden text-ellipsis whitespace-nowrap">
        <span class="flex items-center gap-1.5 text-[#ffdf9f]">
          <span class="material-symbols-outlined text-[15px]">location_on</span>
          {isAr
            ? 'نخدم كافة أحياء حفر الباطن (العزيزية، الخالدية، المحمدية، أبو موسى، الروضة، البلدية)'
            : 'Serving all Hafar Al-Batin districts — Al-Aziziyah, Al-Khalidiyah, Al-Muhammadiyah & more'}
        </span>
        <span class="hidden lg:flex items-center gap-1.5 opacity-80">
          <span class="material-symbols-outlined text-[15px]">schedule</span>
          {isAr ? SITE.hours : SITE.hoursEn}
        </span>
      </div>

      <div class="flex items-center gap-5 shrink-0">
        <a href={`tel:${SITE.phone}`} dir="ltr"
           class="flex items-center gap-1.5 hover:text-[#ffdf9f] transition-colors">
          <span class="material-symbols-outlined text-[15px]">call</span>
          <span>{SITE.phoneDisplay}</span>
        </a>
        <a href={waLink(lang)} target="_blank" rel="noopener"
           class="flex items-center gap-1.5 text-[#66ff8e] hover:text-white transition-colors">
          <span class="material-symbols-outlined text-[15px]">chat</span>
          <span>{isAr ? 'واتساب فوري' : 'WhatsApp'}</span>
        </a>
        <span class="opacity-30">|</span>
        <a href={switchLang.href}
           class="hover:text-[#ffdf9f] transition-colors text-xs font-semibold">
          {switchLang.label}
        </a>
      </div>

    </div>
  </div>

  <!-- ── Main nav bar ── -->
  <div class="bg-[#fcf9f2]/92 backdrop-blur-xl border-b border-[#e5e2db]/50">
    <div class="h-20 max-w-7xl mx-auto px-6 lg:px-12 flex items-center justify-between gap-4">

      <!-- Logo -->
      <a href={isAr ? '/' : '/en/'} class="flex items-center gap-3 shrink-0 group">
        <div class="w-9 h-9 rounded-lg bg-[#0b2545] flex items-center justify-center text-white font-bold text-sm shrink-0">
          JB
        </div>
        <div class="flex flex-col leading-none">
          <span class="text-[#001026] font-bold text-base tracking-tight">
            {isAr ? 'جلي بلاط حفرالباطن' : 'JaliBlaat Al Batin'}
          </span>
          <span class="text-[#735b24] text-[10px] font-semibold uppercase tracking-widest">
            {isAr ? 'JaliBlaat Al Batin' : 'Luxury Stoneworks'}
          </span>
        </div>
      </a>

      <!-- Desktop nav -->
      <nav class="hidden xl:flex items-center gap-6 text-sm font-semibold font-['Inter']">
        {navLinks.map(link => (
          <a href={link.href}
             class="text-[#44474e] hover:text-[#001026] transition-colors py-2 border-b-2 border-transparent hover:border-[#735b24]">
            {link.label}
          </a>
        ))}
      </nav>

      <!-- CTA buttons + mobile menu trigger -->
      <div class="flex items-center gap-3 shrink-0">
        <!-- WhatsApp CTA -->
        <a href={waLink(lang)} target="_blank" rel="noopener"
           class="hidden sm:inline-flex items-center gap-2 bg-[#002c0f] text-[#66ff8e] hover:bg-[#001404] transition-colors px-4 py-2.5 rounded text-xs font-bold font-['Inter'] shadow-sm wa-pulse">
          <span class="material-symbols-outlined text-[17px]">chat</span>
          <span>{isAr ? 'معاينة مجانية' : 'Free Inspection'}</span>
        </a>
        <!-- Call CTA -->
        <a href={`tel:${SITE.phone}`}
           class="inline-flex items-center gap-2 bg-[#001026] text-white hover:bg-[#0b2545] transition-colors px-4 py-2.5 rounded text-xs font-bold font-['Inter']">
          <span class="material-symbols-outlined text-[17px]">phone_in_talk</span>
          <span class="hidden md:inline">{isAr ? 'اتصال سريع' : 'Call Now'}</span>
        </a>
        <!-- Mobile hamburger -->
        <button id="menu-toggle" aria-label="Toggle menu"
                class="xl:hidden w-9 h-9 flex flex-col items-center justify-center gap-1.5 rounded">
          <span class="w-5 h-0.5 bg-[#001026] transition-all"></span>
          <span class="w-5 h-0.5 bg-[#001026] transition-all"></span>
          <span class="w-5 h-0.5 bg-[#001026] transition-all"></span>
        </button>
      </div>

    </div>

    <!-- Mobile nav dropdown -->
    <nav id="mobile-menu"
         class="xl:hidden hidden border-t border-[#e5e2db]/60 bg-[#fcf9f2] px-6 py-4 flex flex-col gap-1">
      {navLinks.map(link => (
        <a href={link.href}
           class="py-3 text-sm font-semibold text-[#44474e] hover:text-[#001026] border-b border-[#e5e2db]/40 transition-colors">
          {link.label}
        </a>
      ))}
      <div class="pt-3 flex gap-3">
        <a href={waLink(lang)} target="_blank" rel="noopener"
           class="flex-1 flex items-center justify-center gap-2 bg-[#002c0f] text-[#66ff8e] rounded py-3 text-sm font-bold font-['Inter']">
          <span class="material-symbols-outlined text-[18px]">chat</span>
          {isAr ? 'واتساب' : 'WhatsApp'}
        </a>
        <a href={`tel:${SITE.phone}`}
           class="flex-1 flex items-center justify-center gap-2 bg-[#001026] text-white rounded py-3 text-sm font-bold font-['Inter']">
          <span class="material-symbols-outlined text-[18px]">call</span>
          {isAr ? 'اتصال' : 'Call'}
        </a>
      </div>
    </nav>

  </div>
</header>

<script>
  const toggle = document.getElementById('menu-toggle');
  const menu   = document.getElementById('mobile-menu');
  toggle?.addEventListener('click', () => menu?.classList.toggle('hidden'));
</script>
