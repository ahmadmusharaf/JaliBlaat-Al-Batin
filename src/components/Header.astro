---
// src/components/Header.astro
// Bilingual sticky header — renders Arabic or English version based on `lang` prop
import { SITE, sitePath, waLink } from '../data/site';

export interface Props {
  lang?: 'ar' | 'en';
  currentPage?: string;
}

const { lang = 'ar', currentPage = 'home' } = Astro.props;
const isAr = lang === 'ar';

const navLinks = isAr
  ? [
      { href: sitePath('/'),                  label: 'الرئيسية',       key: 'home' },
      { href: sitePath('/ar/services/'),      label: 'خدماتنا',        key: 'services' },
      { href: sitePath('/ar/our-work/'),      label: 'أعمالنا',         key: 'our-work' },
      { href: sitePath('/ar/pricing/'),       label: 'فريقنا وطريقة عملنا', key: 'pricing' },
      { href: sitePath('/ar/service-areas/'), label: 'مناطق الخدمة',  key: 'areas' },
      { href: sitePath('/ar/contact/'),       label: 'اتصل بنا',       key: 'contact' },
    ]
  : [
      { href: sitePath('/en/'),               label: 'Home',          key: 'home' },
      { href: sitePath('/en/services/'),      label: 'Services',      key: 'services' },
      { href: sitePath('/en/our-work/'),      label: 'Our Work',      key: 'our-work' },
      { href: sitePath('/en/pricing/'),       label: 'Team & Workflow', key: 'pricing' },
      { href: sitePath('/en/service-areas/'), label: 'Service Areas', key: 'areas' },
      { href: sitePath('/en/contact/'),       label: 'Contact',       key: 'contact' },
    ];

const switchLang = isAr ? { href: sitePath('/en/'), label: 'English' } : { href: sitePath('/'), label: 'العربية' };
---

<header class="fixed top-0 inset-x-0 z-50 shadow-[0_1px_8px_rgba(11,37,69,0.06)]">

  <!-- ── Top micro-bar ── -->
  <div class="bg-[#0b2545] text-white/90 hidden md:block text-xs font-medium font-['Inter']">
    <div class="max-w-7xl mx-auto px-6 lg:px-12 h-10 flex items-center justify-between gap-4">

      <div class="flex items-center gap-5 overflow-hidden text-ellipsis whitespace-nowrap">
        <span class="flex items-center gap-1.5 text-[#ffdf9f]">
          <span class="material-symbols-outlined text-[15px]">location_on</span>
          {isAr
            ? <span class="notranslate" translate="no">جلي بلاط حفرالباطن · نخدم كافة الأحياء (العزيزية، الخالدية، المحمدية، أبو موسى، الروضة)</span>
            : <span>Serving all Hafar Al-Batin districts — Al-Aziziyah, Al-Khalidiyah, Al-Muhammadiyah & more</span>}
        </span>
        <span class="hidden lg:flex items-center gap-1.5 opacity-80">
          <span class="material-symbols-outlined text-[15px]">schedule</span>
          {isAr ? SITE.hours : SITE.hoursEn}
        </span>
      </div>

      <div class="flex items-center gap-5 shrink-0">
        <a href={`tel:${SITE.phone}`} dir="ltr"
           class="flex items-center gap-1.5 hover:text-[#ffdf9f] transition-colors">
          <span class="material-symbols-outlined text-[15px]">call</span>
          <span>{SITE.phoneDisplay}</span>
        </a>
        <a href={waLink(lang)} target="_blank" rel="noopener"
           class="flex items-center gap-1.5 text-[#66ff8e] hover:text-white transition-colors">
          <span class="material-symbols-outlined text-[15px]">chat</span>
          <span>{isAr ? 'واتساب فوري' : 'WhatsApp'}</span>
        </a>
        <span class="opacity-30">|</span>
        <a href={switchLang.href}
           class="hover:text-[#ffdf9f] transition-colors text-xs font-semibold">
          {switchLang.label}
        </a>
      </div>

    </div>
  </div>

  <!-- ── Mobile contact + language bar ── -->
  <div class="md:hidden bg-[#0b2545] text-white border-b border-white/10">
    <div class="max-w-7xl mx-auto px-4 h-9 flex items-center justify-between gap-3 text-[11px] font-semibold font-['Inter']">
      <a href={`tel:${SITE.phone}`} dir="ltr" class="inline-flex min-w-0 items-center gap-1.5 text-[#ffdf9f] hover:text-white transition-colors">
        <span class="material-symbols-outlined text-[15px]">call</span>
        <span class="truncate">{isAr ? 'اتصل بنا' : 'Call us'} · {SITE.phoneDisplay}</span>
      </a>
      <a href={switchLang.href} class="inline-flex shrink-0 items-center gap-1.5 rounded-full border border-[#ffdf9f]/40 px-2.5 py-1 text-[#ffdf9f] hover:bg-white/10 transition-colors">
        <span aria-hidden="true">🌐</span>
        <span>{switchLang.label}</span>
      </a>
    </div>
  </div>

  <!-- ── Main nav bar ── -->
  <div class="bg-[#fcf9f2]/95 backdrop-blur-xl border-b border-[#e5e2db]/50">
    <div class="h-20 max-w-7xl mx-auto px-6 lg:px-12 flex items-center justify-between gap-4">

      <!-- Logo -->
      <a href={isAr ? sitePath('/') : sitePath('/en/')} class="flex items-center gap-3 shrink-0 group">
        <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-[#0b2545] to-[#001026] flex items-center justify-center text-white font-bold text-sm shrink-0 shadow-md group-hover:scale-105 transition-transform">
          JB
        </div>
        <div class="flex flex-col leading-none">
          <span class="text-[#001026] font-bold text-base tracking-tight notranslate" translate="no" dir="rtl">
            جلي بلاط حفرالباطن
          </span>
          <span class="text-[#735b24] text-[10px] font-semibold uppercase tracking-widest">
            {isAr ? '0539811299 · تلميع رخام وسيراميك' : 'JaliBlaat Al Batin · 0539811299'}
          </span>
        </div>
      </a>

      <!-- Desktop nav -->
      <nav class="hidden xl:flex items-center gap-1 text-sm font-semibold font-['Inter']">
        {navLinks.map(link => (
          <a href={link.href}
             class={`px-3 py-2 rounded-lg transition-all border-b-2 ${
               currentPage === link.key
                 ? 'text-[#001026] border-[#735b24] bg-[#f6f3ec]'
                 : 'text-[#44474e] border-transparent hover:text-[#001026] hover:border-[#735b24] hover:bg-[#f6f3ec]'
             }`}>
            {link.label}
          </a>
        ))}
      </nav>

      <!-- CTA buttons + mobile menu trigger -->
      <div class="flex items-center gap-3 shrink-0">
        <!-- WhatsApp CTA -->
        <a href={waLink(lang)} target="_blank" rel="noopener"
           class="hidden sm:inline-flex items-center gap-2 bg-[#002c0f] text-[#66ff8e] hover:bg-[#001404] transition-all px-4 py-2.5 rounded-lg text-xs font-bold font-['Inter'] shadow-sm wa-pulse">
          <span class="material-symbols-outlined text-[17px]">chat</span>
          <span>{isAr ? 'معاينة مجانية' : 'Free Inspection'}</span>
        </a>
        <!-- Call CTA -->
        <a href={`tel:${SITE.phone}`}
           class="inline-flex items-center gap-2 bg-[#001026] text-white hover:bg-[#0b2545] transition-all px-4 py-2.5 rounded-lg text-xs font-bold font-['Inter']">
          <span class="material-symbols-outlined text-[17px]">phone_in_talk</span>
          <span class="hidden md:inline">{isAr ? 'اتصال سريع' : 'Call Now'}</span>
        </a>
        <!-- Mobile hamburger -->
        <button id="menu-toggle" aria-label="Toggle menu" aria-expanded="false"
                class="xl:hidden w-10 h-10 flex flex-col items-center justify-center gap-[5px] rounded-lg hover:bg-[#f0eee7] transition-colors">
          <span class="ham-line w-5 h-0.5 bg-[#001026] transition-all origin-center"></span>
          <span class="ham-line w-5 h-0.5 bg-[#001026] transition-all origin-center"></span>
          <span class="ham-line w-5 h-0.5 bg-[#001026] transition-all origin-center"></span>
        </button>
      </div>

    </div>

    <!-- Mobile nav dropdown -->
    <nav id="mobile-menu"
         class="xl:hidden hidden border-t border-[#e5e2db]/60 bg-[#fcf9f2] px-6 py-4 flex flex-col gap-1">
      {navLinks.map(link => (
        <a href={link.href}
           class={`py-3 px-3 rounded-lg text-sm font-semibold border-b border-[#e5e2db]/40 transition-colors ${
             currentPage === link.key
               ? 'text-[#001026] bg-[#f0eee7]'
               : 'text-[#44474e] hover:text-[#001026] hover:bg-[#f6f3ec]'
           }`}>
          {link.label}
        </a>
      ))}
      <div class="pt-3 flex gap-3">
        <a href={waLink(lang)} target="_blank" rel="noopener"
           class="flex-1 flex items-center justify-center gap-2 bg-[#002c0f] text-[#66ff8e] rounded-lg py-3 text-sm font-bold font-['Inter']">
          <span class="material-symbols-outlined text-[18px]">chat</span>
          {isAr ? 'واتساب' : 'WhatsApp'}
        </a>
        <a href={`tel:${SITE.phone}`}
           class="flex-1 flex items-center justify-center gap-2 bg-[#001026] text-white rounded-lg py-3 text-sm font-bold font-['Inter']">
          <span class="material-symbols-outlined text-[18px]">call</span>
          {isAr ? 'اتصال' : 'Call'}
        </a>
      </div>
      <div class="pt-2 border-t border-[#e5e2db]/40 mt-1">
        <a href={switchLang.href} class="block py-2 px-3 text-sm font-semibold text-[#735b24] hover:text-[#001026] transition-colors">
          🌐 {switchLang.label}
        </a>
      </div>
    </nav>

  </div>
</header>

<script>
  const toggle = document.getElementById('menu-toggle');
  const menu   = document.getElementById('mobile-menu');
  const lines  = toggle?.querySelectorAll('.ham-line');

  toggle?.addEventListener('click', () => {
    const isOpen = !menu?.classList.contains('hidden');
    menu?.classList.toggle('hidden');
    toggle.setAttribute('aria-expanded', String(!isOpen));
    // Animate hamburger → X
    if (lines && lines.length === 3) {
      if (!isOpen) {
        (lines[0] as HTMLElement).style.transform = 'translateY(7px) rotate(45deg)';
        (lines[1] as HTMLElement).style.opacity = '0';
        (lines[2] as HTMLElement).style.transform = 'translateY(-7px) rotate(-45deg)';
      } else {
        (lines[0] as HTMLElement).style.transform = '';
        (lines[1] as HTMLElement).style.opacity = '';
        (lines[2] as HTMLElement).style.transform = '';
      }
    }
  });

  // Close mobile menu when any nav link is clicked
  menu?.querySelectorAll('a').forEach(a => {
    a.addEventListener('click', () => {
      menu.classList.add('hidden');
      toggle?.setAttribute('aria-expanded', 'false');
      if (lines && lines.length === 3) {
        (lines[0] as HTMLElement).style.transform = '';
        (lines[1] as HTMLElement).style.opacity = '';
        (lines[2] as HTMLElement).style.transform = '';
      }
    });
  });
</script>
